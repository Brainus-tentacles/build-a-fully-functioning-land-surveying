// --- js/audio.js ---
// Web Audio API Synthesizer for Authentic AOL Instant Messenger (AIM)
// and Land Surveying Total Station / RTK Beeps
class SoundFX {
  constructor() {
    this.ctx = null;
    this.muted = false;
  }

  init() {
    if (!this.ctx) {
      const AudioCtx = window.AudioContext || window.webkitAudioContext;
      if (AudioCtx) {
        this.ctx = new AudioCtx();
      }
    }
    if (this.ctx && this.ctx.state === 'suspended') {
      this.ctx.resume();
    }
  }

  // Classic AIM Incoming IM Chime: crisp three-tone bell chime
  playImChime() {
    if (this.muted) return;
    this.init();
    if (!this.ctx) return;

    const now = this.ctx.currentTime;
    const notes = [
      { freq: 523.25, time: 0.00, dur: 0.12 }, // C5
      { freq: 783.99, time: 0.08, dur: 0.14 }, // G5
      { freq: 1046.50, time: 0.16, dur: 0.35 } // C6
    ];

    notes.forEach(note => {
      const osc = this.ctx.createOscillator();
      const gain = this.ctx.createGain();

      osc.type = 'sine';
      osc.frequency.setValueAtTime(note.freq, now + note.time);

      gain.gain.setValueAtTime(0, now + note.time);
      gain.gain.linearRampToValueAtTime(0.28, now + note.time + 0.02);
      gain.gain.exponentialRampToValueAtTime(0.0001, now + note.time + note.dur);

      osc.connect(gain);
      gain.connect(this.ctx.destination);

      osc.start(now + note.time);
      osc.stop(now + note.time + note.dur);
    });
  }

  // AIM Message Sent Blip / Whoosh
  playImSend() {
    if (this.muted) return;
    this.init();
    if (!this.ctx) return;

    const now = this.ctx.currentTime;
    const osc = this.ctx.createOscillator();
    const gain = this.ctx.createGain();

    osc.type = 'triangle';
    osc.frequency.setValueAtTime(880, now);
    osc.frequency.exponentialRampToValueAtTime(1760, now + 0.08);

    gain.gain.setValueAtTime(0.2, now);
    gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.09);

    osc.connect(gain);
    gain.connect(this.ctx.destination);

    osc.start(now);
    osc.stop(now + 0.09);
  }

  // Classic AIM Door Open: Buddy signed online
  playDoorOpen() {
    if (this.muted) return;
    this.init();
    if (!this.ctx) return;

    const now = this.ctx.currentTime;
    // Low creak followed by latch click
    const osc = this.ctx.createOscillator();
    const gain = this.ctx.createGain();

    osc.type = 'sawtooth';
    osc.frequency.setValueAtTime(110, now);
    osc.frequency.linearRampToValueAtTime(160, now + 0.25);
    osc.frequency.linearRampToValueAtTime(95, now + 0.45);

    gain.gain.setValueAtTime(0.001, now);
    gain.gain.linearRampToValueAtTime(0.12, now + 0.05);
    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.45);

    osc.connect(gain);
    gain.connect(this.ctx.destination);

    osc.start(now);
    osc.stop(now + 0.45);

    // Latch click at end
    const clickOsc = this.ctx.createOscillator();
    const clickGain = this.ctx.createGain();
    clickOsc.type = 'sine';
    clickOsc.frequency.setValueAtTime(1400, now + 0.46);
    clickGain.gain.setValueAtTime(0.18, now + 0.46);
    clickGain.gain.exponentialRampToValueAtTime(0.0001, now + 0.52);

    clickOsc.connect(clickGain);
    clickGain.connect(this.ctx.destination);

    clickOsc.start(now + 0.46);
    clickOsc.stop(now + 0.52);
  }

  // Classic AIM Door Slam: Buddy signed off
  playDoorSlam() {
    if (this.muted) return;
    this.init();
    if (!this.ctx) return;

    const now = this.ctx.currentTime;
    const osc = this.ctx.createOscillator();
    const gain = this.ctx.createGain();

    osc.type = 'triangle';
    osc.frequency.setValueAtTime(180, now);
    osc.frequency.exponentialRampToValueAtTime(45, now + 0.35);

    gain.gain.setValueAtTime(0.35, now);
    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.38);

    osc.connect(gain);
    gain.connect(this.ctx.destination);

    osc.start(now);
    osc.stop(now + 0.38);
  }

  // Survey Data Collector / Total Station High Precision Shot Chirp
  playShotBeep() {
    if (this.muted) return;
    this.init();
    if (!this.ctx) return;

    const now = this.ctx.currentTime;
    // Dual frequency chirp: 2400Hz and 3200Hz
    [2400, 3200].forEach((freq, i) => {
      const osc = this.ctx.createOscillator();
      const gain = this.ctx.createGain();

      const startTime = now + (i * 0.05);
      osc.type = 'sine';
      osc.frequency.setValueAtTime(freq, startTime);

      gain.gain.setValueAtTime(0.25, startTime);
      gain.gain.exponentialRampToValueAtTime(0.001, startTime + 0.04);

      osc.connect(gain);
      gain.connect(this.ctx.destination);

      osc.start(startTime);
      osc.stop(startTime + 0.04);
    });
  }

  // Survey Warning Alert (e.g. poor satellite PDOP or misclosure error)
  playWarningBeep() {
    if (this.muted) return;
    this.init();
    if (!this.ctx) return;

    const now = this.ctx.currentTime;
    const osc = this.ctx.createOscillator();
    const gain = this.ctx.createGain();

    osc.type = 'square';
    osc.frequency.setValueAtTime(440, now);
    osc.frequency.setValueAtTime(350, now + 0.1);

    gain.gain.setValueAtTime(0.18, now);
    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.22);

    osc.connect(gain);
    gain.connect(this.ctx.destination);

    osc.start(now);
    osc.stop(now + 0.22);
  }

  toggleMute() {
    this.muted = !this.muted;
    return this.muted;
  }
}

window.SoundFX = SoundFX;
window.soundFX = new SoundFX();

// --- js/points.js ---
// Survey Points and Coordinate Geometry (COGO) Engine
class PointManager {
  constructor() {
    this.points = [];
    this.rtkStatus = {
      active: true,
      solution: "FIXED", // FIXED, FLOAT, DGPS, AUTONOMOUS, LOCKED (TS)
      sensorMode: "GNSS_RTK", // GNSS_RTK or ROBOTIC_TS
      satellites: 24,
      pdop: 1.05,
      hdop: 0.6,
      vdop: 0.9,
      hrms: 0.011, // ft
      vrms: 0.019, // ft
      baseDistance: 1245.8, // ft
      curN: 10245.80,
      curE: 10185.35,
      curZ: 688.15,
      rodHeight: 6.562, // 2.000m Topcon/Sokkia rover pole = 6.562 ft
      prismConstantMm: -30,
      antennaType: "Topcon HiPer VR (TILT)",
      network: "TopNET Live VRS"
    };
    this.listeners = [];
  }

  setEquipmentProfile(profile) {
    if (!profile) return;
    this.rtkStatus.sensorMode = profile.sensorMode || "GNSS_RTK";
    this.rtkStatus.antennaType = profile.sensorMode === "ROBOTIC_TS"
      ? `${profile.totalStation || "Sokkia iX-1200"} (Prism ${profile.prismConstMm ?? -30}mm)`
      : `${profile.gps || "Topcon HiPer VR"} (TILT)`;
    this.rtkStatus.rodHeight = Number(profile.rodHeight) || (profile.sensorMode === "ROBOTIC_TS" ? 5.000 : 6.562);
    this.rtkStatus.prismConstantMm = profile.prismConstMm ?? -30;
    this.rtkStatus.network = profile.sensorMode === "ROBOTIC_TS"
      ? "LongLink BT Prism Lock"
      : (profile.network || "TopNET Live VRS");
  }

  init(initialPoints) {
    const saved = localStorage.getItem('survey_points');
    if (saved) {
      try {
        this.points = JSON.parse(saved);
      } catch (e) {
        this.points = initialPoints ? [...initialPoints] : [];
      }
    } else {
      this.points = initialPoints ? [...initialPoints] : [];
    }
    this.startRtkSimulation();
  }

  save() {
    localStorage.setItem('survey_points', JSON.stringify(this.points));
    this.notify();
  }

  subscribe(callback) {
    this.listeners.push(callback);
  }

  notify() {
    this.listeners.forEach(cb => {
      try { cb(this.points); } catch (e) { console.error(e); }
    });
  }

  getAll() {
    return this.points;
  }

  getById(id) {
    return this.points.find(p => p.id === Number(id) || p.id === String(id));
  }

  getNextId() {
    if (this.points.length === 0) return 1;
    const maxId = Math.max(...this.points.map(p => Number(p.id) || 0));
    return maxId + 1;
  }

  addPoint(point) {
    const p = {
      id: point.id !== undefined && point.id !== null ? Number(point.id) : this.getNextId(),
      northing: parseFloat(Number(point.northing).toFixed(4)),
      easting: parseFloat(Number(point.easting).toFixed(4)),
      elevation: parseFloat(Number(point.elevation).toFixed(4)),
      code: (point.code || "SHOT").toUpperCase().trim(),
      desc: point.desc || "",
      hi: point.hi ? Number(point.hi) : 5.12,
      hr: point.hr ? Number(point.hr) : this.rtkStatus.rodHeight,
      type: point.type || this.detectPointType(point.code),
      time: new Date().toLocaleTimeString(),
      locked: !!point.locked
    };

    // Replace if ID already exists, else push
    const existingIndex = this.points.findIndex(pt => pt.id === p.id);
    if (existingIndex >= 0) {
      this.points[existingIndex] = p;
    } else {
      this.points.push(p);
    }

    this.save();
    window.soundFX.playShotBeep();
    return p;
  }

  updatePoint(id, data) {
    const idx = this.points.findIndex(p => p.id === Number(id));
    if (idx >= 0) {
      this.points[idx] = { ...this.points[idx], ...data };
      this.save();
      return this.points[idx];
    }
    return null;
  }

  deletePoint(id) {
    const idx = this.points.findIndex(p => p.id === Number(id));
    if (idx >= 0) {
      const deleted = this.points.splice(idx, 1)[0];
      this.save();
      return deleted;
    }
    return null;
  }

  detectPointType(code) {
    if (!code) return "TOPO";
    const c = code.toUpperCase();
    if (c.includes("CP") || c.includes("CTRL")) return "CTRL";
    if (c.includes("BM") || c.includes("BENCH")) return "BM";
    if (c.includes("IP") || c.includes("PIN") || c.includes("CORNER") || c.includes("REBAR")) return "BNDY";
    if (c.includes("CL") || c.includes("EP") || c.includes("CURB") || c.includes("ROAD")) return "ROAD";
    if (c.includes("BLDG") || c.includes("HOUSE") || c.includes("FFE")) return "BLDG";
    if (c.includes("MH") || c.includes("CB") || c.includes("WM") || c.includes("WV") || c.includes("FH") || c.includes("UTIL")) return "UTIL";
    return "TOPO";
  }

  // COGO: Inverse calculation between two coordinates (North, East)
  static inverse(n1, e1, n2, e2, z1 = 0, z2 = 0) {
    const dN = n2 - n1;
    const dE = e2 - e1;
    const dZ = z2 - z1;

    const horizDist = Math.hypot(dN, dE);
    const slopeDist = Math.hypot(dN, dE, dZ);

    // Azimuth from North (0° to 360°)
    let azimuthRad = Math.atan2(dE, dN);
    if (azimuthRad < 0) azimuthRad += 2 * Math.PI;
    const azimuthDeg = (azimuthRad * 180) / Math.PI;

    // Quadrant Bearing (N/S, Deg, Min, Sec, E/W)
    const bearing = PointManager.azimuthToBearing(azimuthDeg);

    // Grade percentage
    const grade = horizDist !== 0 ? (dZ / horizDist) * 100 : 0;

    return {
      deltaN: dN,
      deltaE: dE,
      deltaZ: dZ,
      horizDist,
      slopeDist,
      azimuthDeg,
      bearing,
      grade
    };
  }

  // Convert decimal degrees azimuth (0-360) to Quadrant Bearing string
  static azimuthToBearing(azimuthDeg) {
    const az = ((azimuthDeg % 360) + 360) % 360;
    let quad = "";
    let angle = 0;

    if (az >= 0 && az <= 90) {
      quad = "NE";
      angle = az;
    } else if (az > 90 && az <= 180) {
      quad = "SE";
      angle = 180 - az;
    } else if (az > 180 && az <= 270) {
      quad = "SW";
      angle = az - 180;
    } else {
      quad = "NW";
      angle = 360 - az;
    }

    const deg = Math.floor(angle);
    const minDec = (angle - deg) * 60;
    const min = Math.floor(minDec);
    const sec = Math.round((minDec - min) * 60);

    const prefix = quad[0];
    const suffix = quad[1];
    const sMin = min < 10 ? "0" + min : min;
    const sSec = sec < 10 ? "0" + sec : sec;

    return `${prefix} ${deg}° ${sMin}' ${sSec}" ${suffix}`;
  }

  // RTK GNSS Simulator / GPS live update
  startRtkSimulation() {
    if (this._simInterval) clearInterval(this._simInterval);
    this._simInterval = setInterval(() => {
      if (!this.rtkStatus.active) return;
      // Slight wandering noise for realistic RTK jitter (±0.005 ft)
      const jitterN = (Math.random() - 0.5) * 0.010;
      const jitterE = (Math.random() - 0.5) * 0.010;
      const jitterZ = (Math.random() - 0.5) * 0.015;

      this.rtkStatus.curN += jitterN;
      this.rtkStatus.curE += jitterE;
      this.rtkStatus.curZ += jitterZ;

      this.rtkStatus.hrms = 0.008 + Math.random() * 0.008;
      this.rtkStatus.vrms = 0.014 + Math.random() * 0.010;
      this.rtkStatus.pdop = 0.95 + Math.random() * 0.30;
      this.rtkStatus.satellites = 22 + Math.floor(Math.random() * 5);

      const badge = document.getElementById('rtk-hud-coords');
      if (badge) {
        badge.innerHTML = `N: <b>${this.rtkStatus.curN.toFixed(2)}</b> E: <b>${this.rtkStatus.curE.toFixed(2)}</b> Z: <b>${this.rtkStatus.curZ.toFixed(2)}</b>`;
      }
    }, 1500);
  }

  // Trigger real device Geolocation if on phone/browser
  connectDeviceGps(onSuccess, onError) {
    if (!navigator.geolocation) {
      if (onError) onError("Geolocation is not supported by your browser");
      return;
    }
    navigator.geolocation.getCurrentPosition(
      pos => {
        // Approximate conversion from GPS Lat/Long to local survey state plane feet
        const lat = pos.coords.latitude;
        const lon = pos.coords.longitude;
        const altFt = (pos.coords.altitude || 100) * 3.28084;
        const accuracyFt = pos.coords.accuracy * 3.28084;

        this.rtkStatus.solution = accuracyFt < 10 ? "DGPS/FIXED" : "AUTONOMOUS";
        this.rtkStatus.hrms = accuracyFt;
        this.rtkStatus.satellites = 14;

        if (onSuccess) onSuccess({ lat, lon, altFt, accuracyFt });
      },
      err => {
        if (onError) onError(err.message);
      },
      { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
    );
  }

  // Rapid shot from RTK Rover / Robotic Total Station
  takeRtkShot(code, desc = "", rodHeight = null) {
    const hrVal = rodHeight !== null && !isNaN(Number(rodHeight)) ? Number(rodHeight) : this.rtkStatus.rodHeight;
    const modeTag = this.rtkStatus.sensorMode === "ROBOTIC_TS" ? "TS LOCK" : `RTK ${this.rtkStatus.solution}`;
    const pt = this.addPoint({
      northing: this.rtkStatus.curN,
      easting: this.rtkStatus.curE,
      elevation: this.rtkStatus.curZ,
      code: code || "GPS",
      desc: desc || `${modeTag} (${this.rtkStatus.antennaType}) HRMS:${this.rtkStatus.hrms.toFixed(3)}ft`,
      hr: hrVal
    });
    return pt;
  }

  // Stakeout / Construction Staking Navigation Engine
  getStakeoutDelta(targetPtId) {
    const target = this.getById(targetPtId);
    if (!target) return null;

    const curN = this.rtkStatus.curN;
    const curE = this.rtkStatus.curE;
    const curZ = this.rtkStatus.curZ;

    const dN = target.northing - curN;
    const dE = target.easting - curE;
    const dZ = target.elevation - curZ;

    const horizDist = Math.hypot(dN, dE);
    const inv = PointManager.inverse(curN, curE, target.northing, target.easting, curZ, target.elevation);

    // Human navigation directions
    let dirN = "";
    if (Math.abs(dN) >= 0.02) {
      dirN = dN > 0 ? `GO NORTH ${dN.toFixed(2)} ft` : `GO SOUTH ${Math.abs(dN).toFixed(2)} ft`;
    } else {
      dirN = "NORTH/SOUTH ON TARGET";
    }

    let dirE = "";
    if (Math.abs(dE) >= 0.02) {
      dirE = dE > 0 ? `GO EAST ${dE.toFixed(2)} ft` : `GO WEST ${Math.abs(dE).toFixed(2)} ft`;
    } else {
      dirE = "EAST/WEST ON TARGET";
    }

    const cutFill = dZ > 0.01 ? `FILL +${dZ.toFixed(2)} ft` : dZ < -0.01 ? `CUT ${dZ.toFixed(2)} ft` : "GRADE ON TARGET (0.00 ft)";
    const inTolerance = horizDist <= 0.05;

    return {
      target,
      curN,
      curE,
      curZ,
      dN,
      dE,
      dZ,
      horizDist,
      bearing: inv.bearing,
      dirN,
      dirE,
      cutFill,
      inTolerance
    };
  }
}

window.PointManager = PointManager;
window.pointManager = new PointManager();

// --- js/cad-engine.js ---
// Simplistic Land Surveying Linework & Field Drawing Engine
// Clean, touch-friendly linework tool for boundary, road, utilities & buildings with DXF upload/download
class CadEngine {
  constructor(canvasId) {
    this.canvas = document.getElementById(canvasId);
    this.ctx = this.canvas ? this.canvas.getContext('2d') : null;

    // Viewport transform (World: Northing, Easting in survey feet)
    this.originN = 10250.0;
    this.originE = 10250.0;
    this.scale = 1.0;
    this.minScale = 0.05;
    this.maxScale = 30.0;

    // Interaction states
    this.isPanning = false;
    this.lastMouseX = 0;
    this.lastMouseY = 0;
    this.activeTool = 'line'; // 'line', 'point', 'measure', 'pan', 'select'
    this.currentFeature = 'BOUNDARY'; // 'BOUNDARY', 'CENTERLINE', 'EOP_CURB', 'BUILDING', 'UTILITIES'

    // Snapping
    this.snapRadius = 22; // pixels
    this.snappedPoint = null;

    // Active linework vertices
    this.activeVertices = [];
    this.mouseWorldN = 10250.0;
    this.mouseWorldE = 10250.0;
    this.cursorScreenX = 0;
    this.cursorScreenY = 0;

    // Survey Feature Definitions
    this.features = {
      BOUNDARY: { name: "Boundary", c3d: "V-PROP-LINE", color: "#ef4444", lineWidth: 2.5, closed: true, dash: [] },
      CENTERLINE: { name: "Road Centerline", c3d: "V-ROAD-CNTR", color: "#eab308", lineWidth: 2.0, closed: false, dash: [8, 4] },
      EOP_CURB: { name: "Edge of Pavement", c3d: "V-ROAD-CURB", color: "#94a3b8", lineWidth: 1.8, closed: false, dash: [] },
      BUILDING: { name: "Building Footprint", c3d: "V-BLDG", color: "#a855f7", lineWidth: 2.0, closed: true, dash: [] },
      UTILITIES: { name: "Utilities / SUE", c3d: "V-UTIL-WATR", color: "#0284c7", lineWidth: 2.0, closed: false, dash: [12, 4] },
      FIELD_SKETCHES: { name: "Fence / Sketch", c3d: "V-SITE-FENC", color: "#f97316", lineWidth: 1.5, closed: false, dash: [] },
      SKETCH: { name: "Field Sketch", c3d: "V-SITE-FENC", color: "#f97316", lineWidth: 1.5, closed: false, dash: [] }
    };

    // Layer visibility (paired with Autodesk Civil 3D NCS Layers)
    this.layers = {
      BOUNDARY: { name: "Boundary (Red)", c3d: "V-PROP-LINE", color: "#ef4444", visible: true },
      CENTERLINE: { name: "Centerline (Yellow)", c3d: "V-ROAD-CNTR", color: "#eab308", visible: true },
      EOP_CURB: { name: "EOP / Curb (Gray)", c3d: "V-ROAD-CURB", color: "#94a3b8", visible: true },
      BUILDING: { name: "Building (Purple)", c3d: "V-BLDG", color: "#a855f7", visible: true },
      UTILITIES: { name: "Utilities / SUE (Blue)", c3d: "V-UTIL-WATR", color: "#0284c7", visible: true },
      FIELD_SKETCHES: { name: "Fence / Sketches (Orange)", c3d: "V-SITE-FENC", color: "#f97316", visible: true },
      POINTS: { name: "Survey Points", c3d: "V-NODE-PNT", color: "#ffffff", visible: true, showLabels: true }
    };
    this.layerModalOpen = false;

    this.linework = [];
    this.touchPinchDist = null;

    if (this.canvas) {
      this.initEvents();
    }
  }

  init(initialLinework) {
    const saved = localStorage.getItem('survey_linework');
    if (saved) {
      try {
        this.linework = JSON.parse(saved);
      } catch (e) {
        this.linework = initialLinework ? [...initialLinework] : [];
      }
    } else {
      this.linework = initialLinework ? [...initialLinework] : [];
    }

    this.resizeCanvas();
    window.addEventListener('resize', () => this.resizeCanvas());

    setTimeout(() => {
      this.fitExtents();
      this.render();
    }, 50);
  }

  save() {
    localStorage.setItem('survey_linework', JSON.stringify(this.linework));
  }

  resizeCanvas() {
    if (!this.canvas) return;
    const rect = this.canvas.parentElement.getBoundingClientRect();
    const dpr = window.devicePixelRatio || 1;

    this.width = rect.width || 800;
    this.height = rect.height || 500;

    this.canvas.width = this.width * dpr;
    this.canvas.height = this.height * dpr;

    this.ctx = this.canvas.getContext('2d');
    this.ctx.scale(dpr, dpr);
    this.render();
  }

  worldToScreen(northing, easting) {
    const screenX = (easting - this.originE) * this.scale + (this.width / 2);
    const screenY = (this.height / 2) - (northing - this.originN) * this.scale;
    return { x: screenX, y: screenY };
  }

  screenToWorld(screenX, screenY) {
    const easting = this.originE + (screenX - (this.width / 2)) / this.scale;
    const northing = this.originN + ((this.height / 2) - screenY) / this.scale;
    return { northing, easting };
  }

  initEvents() {
    this.canvas.addEventListener('mousedown', e => this.handleMouseDown(e));
    this.canvas.addEventListener('mousemove', e => this.handleMouseMove(e));
    this.canvas.addEventListener('mouseup', e => this.handleMouseUp(e));
    this.canvas.addEventListener('wheel', e => this.handleWheel(e), { passive: false });
    this.canvas.addEventListener('dblclick', () => this.finishActiveDrawing());

    this.canvas.addEventListener('touchstart', e => this.handleTouchStart(e), { passive: false });
    this.canvas.addEventListener('touchmove', e => this.handleTouchMove(e), { passive: false });
    this.canvas.addEventListener('touchend', () => this.handleTouchEnd());

    window.addEventListener('keydown', e => {
      if (e.key === 'Escape') this.cancelActiveDrawing();
      if (e.key === 'Enter') this.finishActiveDrawing();
    });
  }

  handleMouseDown(e) {
    e.preventDefault();
    const rect = this.canvas.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;

    if (e.button === 1 || this.activeTool === 'pan') {
      this.isPanning = true;
      this.lastMouseX = x;
      this.lastMouseY = y;
      return;
    }

    if (e.button === 0) {
      this.handleAction(x, y);
    }
  }

  handleMouseMove(e) {
    const rect = this.canvas.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;
    this.cursorScreenX = x;
    this.cursorScreenY = y;

    if (this.isPanning) {
      const dx = x - this.lastMouseX;
      const dy = y - this.lastMouseY;
      this.originE -= dx / this.scale;
      this.originN += dy / this.scale;
      this.lastMouseX = x;
      this.lastMouseY = y;
      this.render();
      return;
    }

    const world = this.screenToWorld(x, y);
    this.mouseWorldN = world.northing;
    this.mouseWorldE = world.easting;

    this.checkSnap(x, y);
    this.updateHUD();
    this.render();
  }

  handleMouseUp() {
    this.isPanning = false;
  }

  handleWheel(e) {
    e.preventDefault();
    const rect = this.canvas.getBoundingClientRect();
    const mx = e.clientX - rect.left;
    const my = e.clientY - rect.top;
    const factor = e.deltaY < 0 ? 1.15 : 0.87;
    this.zoomAt(mx, my, factor);
  }

  handleTouchStart(e) {
    e.preventDefault();
    const rect = this.canvas.getBoundingClientRect();

    if (e.touches.length === 1) {
      const t = e.touches[0];
      const x = t.clientX - rect.left;
      const y = t.clientY - rect.top;
      this.lastMouseX = x;
      this.lastMouseY = y;
      this.cursorScreenX = x;
      this.cursorScreenY = y;

      if (this.activeTool === 'pan') {
        this.isPanning = true;
      } else {
        this.handleAction(x, y);
      }
    } else if (e.touches.length === 2) {
      this.isPanning = false;
      const dx = e.touches[0].clientX - e.touches[1].clientX;
      const dy = e.touches[0].clientY - e.touches[1].clientY;
      this.touchPinchDist = Math.hypot(dx, dy);
    }
  }

  handleTouchMove(e) {
    e.preventDefault();
    const rect = this.canvas.getBoundingClientRect();

    if (e.touches.length === 1) {
      const t = e.touches[0];
      const x = t.clientX - rect.left;
      const y = t.clientY - rect.top;
      this.cursorScreenX = x;
      this.cursorScreenY = y;

      if (this.isPanning || this.activeTool === 'pan') {
        const dx = x - this.lastMouseX;
        const dy = y - this.lastMouseY;
        this.originE -= dx / this.scale;
        this.originN += dy / this.scale;
        this.lastMouseX = x;
        this.lastMouseY = y;
        this.render();
      } else {
        const world = this.screenToWorld(x, y);
        this.mouseWorldN = world.northing;
        this.mouseWorldE = world.easting;
        this.checkSnap(x, y);
        this.render();
      }
    } else if (e.touches.length === 2 && this.touchPinchDist) {
      const dx = e.touches[0].clientX - e.touches[1].clientX;
      const dy = e.touches[0].clientY - e.touches[1].clientY;
      const newDist = Math.hypot(dx, dy);
      const factor = newDist / this.touchPinchDist;

      const midX = (e.touches[0].clientX + e.touches[1].clientX) / 2 - rect.left;
      const midY = (e.touches[0].clientY + e.touches[1].clientY) / 2 - rect.top;

      this.zoomAt(midX, midY, factor);
      this.touchPinchDist = newDist;
    }
  }

  handleTouchEnd() {
    this.touchPinchDist = null;
    this.isPanning = false;
  }

  zoomAt(screenX, screenY, factor) {
    const worldBefore = this.screenToWorld(screenX, screenY);
    const newScale = Math.max(this.minScale, Math.min(this.maxScale, this.scale * factor));
    this.scale = newScale;

    const worldAfter = this.screenToWorld(screenX, screenY);
    this.originE += (worldBefore.easting - worldAfter.easting);
    this.originN += (worldBefore.northing - worldAfter.northing);
    this.render();
  }

  checkSnap(screenX, screenY) {
    this.snappedPoint = null;
    if (!window.pointManager) return;

    const points = window.pointManager.getAll();
    let minDist = this.snapRadius;

    for (const pt of points) {
      const sp = this.worldToScreen(pt.northing, pt.easting);
      const dist = Math.hypot(screenX - sp.x, screenY - sp.y);
      if (dist < minDist) {
        minDist = dist;
        this.snappedPoint = pt;
      }
    }
  }

  handleAction(screenX, screenY) {
    let targetN = this.mouseWorldN;
    let targetE = this.mouseWorldE;
    let targetZ = 685.00;
    let pointId = null;

    if (this.snappedPoint) {
      targetN = this.snappedPoint.northing;
      targetE = this.snappedPoint.easting;
      targetZ = this.snappedPoint.elevation;
      pointId = this.snappedPoint.id;
    }

    const vertex = { id: pointId, n: targetN, e: targetE, z: targetZ };

    if (this.activeTool === 'select') {
      if (this.snappedPoint) {
        this.inspectPoint(this.snappedPoint);
      }
    } else if (this.activeTool === 'line') {
      this.activeVertices.push(vertex);
    } else if (this.activeTool === 'point') {
      if (window.app && typeof window.app.openQuickShotModal === 'function') {
        window.app.openQuickShotModal(targetN, targetE, targetZ, 'canvas');
      } else {
        const code = prompt("Enter MAGNET Field Code (e.g. IP FND, EP1 B, CL1, BM):", "IP FND");
        if (code !== null) {
          const desc = prompt("Enter Description / Notes:", "Survey Monument") || "";
          window.pointManager.addPoint({
            northing: targetN,
            easting: targetE,
            elevation: targetZ,
            code: code.toUpperCase(),
            desc
          });
          this.render();
        }
      }
    } else if (this.activeTool === 'measure') {
      this.activeVertices.push(vertex);
      if (this.activeVertices.length === 2) {
        const p1 = this.activeVertices[0];
        const p2 = this.activeVertices[1];
        const inv = PointManager.inverse(p1.n, p1.e, p2.n, p2.e, p1.z, p2.z);
        this.showMeasurePopup(inv);
        this.activeVertices = [];
      }
    }

    this.render();
  }

  finishActiveDrawing() {
    if (this.activeVertices.length >= 2) {
      const feat = this.features[this.currentFeature] || this.features.BOUNDARY;
      const newLine = {
        id: "line-" + Date.now(),
        layer: feat.c3d || this.currentFeature,
        name: `${feat.name} Linework`,
        color: feat.color,
        lineWidth: feat.lineWidth,
        dash: feat.dash || [],
        closed: feat.closed && this.activeVertices.length >= 3,
        points: [...this.activeVertices]
      };

      this.linework.push(newLine);
      this.save();
      if (window.soundFX) window.soundFX.playShotBeep();
      this.activeVertices = [];
      this.render();
      this.renderLayerModal();
    }
  }

  cancelActiveDrawing() {
    this.activeVertices = [];
    this.render();
  }

  setFeature(featureName) {
    if (this.features[featureName]) {
      this.currentFeature = featureName;
      document.querySelectorAll('.survey-feat-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.feat === featureName);
      });
      const hint = document.getElementById('cad-tool-instruction');
      if (hint) {
        hint.textContent = `Drawing ${this.features[featureName].name}. Tap points to connect line, then tap 'Finish Line'.`;
      }
    }
  }

  setTool(tool) {
    this.cancelActiveDrawing();
    this.activeTool = tool;
    this.canvas.style.cursor = tool === 'pan' ? 'grab' : 'crosshair';

    document.querySelectorAll('.cad-tool-btn').forEach(btn => {
      btn.classList.toggle('active', btn.dataset.tool === tool);
    });

    const hint = document.getElementById('cad-tool-instruction');
    if (hint) {
      const map = {
        line: `Drawing ${this.features[this.currentFeature].name}. Tap points to connect, then click 'Finish Line'.`,
        point: `Tap anywhere on canvas to set a new coordinate point.`,
        measure: `Tap two points to calculate Quadrant Bearing & Horizontal Distance (COGO).`,
        pan: `Drag to pan across the survey site.`,
        select: `Tap any point to inspect coordinate attributes.`
      };
      hint.textContent = map[tool] || "";
    }
  }

  sendLineworkToAim() {
    const count = this.linework.length;
    const bndy = this.linework.filter(l => this.normalizeLayerKey(l.layer) === 'BOUNDARY').length;
    const road = this.linework.filter(l => {
      const k = this.normalizeLayerKey(l.layer);
      return k === 'CENTERLINE' || k === 'EOP_CURB';
    }).length;

    const html = `
      <div class="chat-cogo-badge">
        <span class="badge-tag">📐 MAGNET LINEWORK → CIVIL 3D</span>
        <div>Total Figures: <b>${count}</b> (Boundary: ${bndy}, Road: ${road})</div>
        <div class="badge-coords">Civil 3D Layers: V-PROP-LINE, V-ROAD-CNTR, V-ROAD-CURB, V-BLDG, V-UTIL-WATR</div>
        <span class="badge-link" onclick="window.app.switchTab('cad')">🔍 View on Survey Linework Canvas</span>
      </div>
    `;

    if (window.aimChat) {
      window.aimChat.sendMessage(`Transmitted MAGNET Field Linework (${count} figures) to Civil 3D Office`, html);
      if (window.app && window.app.showToast) {
        window.app.showToast(`Shared ${count} survey figures to Civil 3D Office via AIM!`);
      }
      window.app.switchTab('aim');
    }
  }

  normalizeLayerKey(layerName) {
    if (!layerName) return 'BOUNDARY';
    const up = String(layerName).trim().toUpperCase();
    if (this.layers[up]) return up;
    if (up === 'SKETCH' || up.includes('FENC') || up.includes('SKETCH')) return 'FIELD_SKETCHES';
    if (up.includes('PROP') || up.includes('BND')) return 'BOUNDARY';
    if (up.includes('CNTR') || up.includes('CENTER')) return 'CENTERLINE';
    if (up.includes('CURB') || up.includes('EOP')) return 'EOP_CURB';
    if (up.includes('BLDG') || up.includes('BUILD')) return 'BUILDING';
    if (up.includes('UTIL') || up.includes('WATR') || up.includes('SSWR') || up.includes('STRM')) return 'UTILITIES';
    if (up.includes('NODE') || up.includes('PNT') || up.includes('POINT')) return 'POINTS';
    return 'BOUNDARY';
  }

  toggleLayerModal() {
    this.layerModalOpen = !this.layerModalOpen;
    this.renderLayerModal();
  }

  toggleLayerVisibility(key) {
    if (this.layers[key]) {
      this.layers[key].visible = !this.layers[key].visible;
      this.renderLayerModal();
      this.render();
    }
  }

  renderLayerModal() {
    const el = document.getElementById('cad-layer-modal');
    if (!el) return;
    if (!this.layerModalOpen) {
      el.innerHTML = '';
      return;
    }

    const ptsCount = window.pointManager ? window.pointManager.getAll().length : 0;
    const rows = Object.keys(this.layers).map(key => {
      const lyr = this.layers[key];
      const count = key === 'POINTS'
        ? ptsCount
        : this.linework.filter(l => this.normalizeLayerKey(l.layer) === key).length;
      return `
        <label class="layer-item-row" style="cursor:pointer;">
          <input type="checkbox" ${lyr.visible ? 'checked' : ''} onchange="window.cadEngine.toggleLayerVisibility('${key}')">
          <span class="layer-color-badge" style="background:${lyr.color}"></span>
          <span class="layer-name-label" title="${lyr.c3d}">${lyr.name} <small style="color:#64748b">(${lyr.c3d})</small></span>
          <span class="layer-count-badge">${count}</span>
        </label>
      `;
    }).join('');

    el.innerHTML = `
      <div class="cad-layer-modal-dialog">
        <div class="cad-layer-modal-header">
          <span>🗂️ Civil 3D / MAGNET Layers</span>
          <button class="btn-close" onclick="window.cadEngine.toggleLayerModal()">×</button>
        </div>
        <div class="cad-layer-list">${rows}</div>
        <div class="cad-layer-modal-footer">
          <button class="btn btn-xs btn-outline-warning" onclick="window.dxfManager.exportCivil3dFbk()">📤 Export Civil 3D .FBK</button>
        </div>
      </div>
    `;
  }

  showMeasurePopup(inv) {
    const el = document.getElementById('cad-measure-results');
    if (el) {
      el.innerHTML = `
        <div class="measure-popup">
          <div class="measure-header">📐 Inverse Calculation (COGO)</div>
          <div class="measure-body">
            <div class="measure-row"><span>Quadrant Bearing:</span> <b class="text-accent">${inv.bearing}</b></div>
            <div class="measure-row"><span>Horizontal Distance:</span> <b>${inv.horizDist.toFixed(2)} ft</b></div>
            <div class="measure-row"><span>Slope Distance:</span> <b>${inv.slopeDist.toFixed(2)} ft</b></div>
            <div class="measure-row"><span>Delta North (ΔN):</span> <b>${inv.deltaN.toFixed(2)} ft</b></div>
            <div class="measure-row"><span>Delta East (ΔE):</span> <b>${inv.deltaE.toFixed(2)} ft</b></div>
            <div class="measure-row"><span>Grade (%):</span> <b>${inv.grade.toFixed(2)}%</b></div>
          </div>
          <button class="btn btn-xs btn-primary mt-2 w-full" onclick="window.aimChat.sendInverseToChat('${inv.bearing}', ${inv.horizDist.toFixed(2)}, ${inv.deltaZ.toFixed(2)})">
            💬 Post Inverse to AIM Chat
          </button>
        </div>
      `;
    }
  }

  inspectPoint(pt) {
    const el = document.getElementById('cad-inspector');
    if (el) {
      el.innerHTML = `
        <div class="inspector-card">
          <div class="inspector-header">
            <span class="badge ${pt.type || 'TOPO'}">PT #${pt.id}</span>
            <span class="inspector-code">${pt.code}</span>
          </div>
          <div class="inspector-grid">
            <div class="insp-item"><span>Northing:</span><b>${pt.northing.toFixed(3)}</b></div>
            <div class="insp-item"><span>Easting:</span><b>${pt.easting.toFixed(3)}</b></div>
            <div class="insp-item"><span>Elevation:</span><b>${pt.elevation.toFixed(3)}'</b></div>
            <div class="insp-item"><span>Description:</span><span>${pt.desc || '-'}</span></div>
          </div>
          <div class="inspector-actions">
            <button class="btn btn-xs btn-primary" onclick="window.aimChat.sendPointToChat(${pt.id})">💬 Send to AIM</button>
            <button class="btn btn-xs btn-secondary" onclick="window.cadEngine.zoomToPoint(${pt.id})">🔍 Zoom</button>
          </div>
        </div>
      `;
    }
  }

  fitExtents() {
    let minN = Infinity, maxN = -Infinity, minE = Infinity, maxE = -Infinity;

    if (window.pointManager) {
      window.pointManager.getAll().forEach(p => {
        if (p.northing < minN) minN = p.northing;
        if (p.northing > maxN) maxN = p.northing;
        if (p.easting < minE) minE = p.easting;
        if (p.easting > maxE) maxE = p.easting;
      });
    }

    if (minN === Infinity) {
      this.originN = 10250.0;
      this.originE = 10250.0;
      this.scale = 1.0;
      return;
    }

    this.originN = (minN + maxN) / 2;
    this.originE = (minE + maxE) / 2;

    const pad = 1.35;
    const rangeN = (maxN - minN) || 200;
    const rangeE = (maxE - minE) || 200;

    this.scale = Math.min(this.height / (rangeN * pad), this.width / (rangeE * pad), 3.0);
    this.render();
  }

  zoomToPoint(pointId) {
    const pt = window.pointManager.getById(pointId);
    if (!pt) return;
    this.originN = pt.northing;
    this.originE = pt.easting;
    this.scale = 3.5;
    this.inspectPoint(pt);
    this.render();
  }

  updateHUD() {
    const el = document.getElementById('cad-coord-hud');
    if (el) {
      const snapTag = this.snappedPoint ? ` • SNAP #${this.snappedPoint.id}` : '';
      el.innerHTML = `N: <b>${this.mouseWorldN.toFixed(2)}</b> E: <b>${this.mouseWorldE.toFixed(2)}</b>${snapTag}`;
    }
  }

  render() {
    if (!this.ctx) return;
    const ctx = this.ctx;
    ctx.clearRect(0, 0, this.width, this.height);

    this.drawGrid(ctx);
    this.drawLinework(ctx);
    this.drawActive(ctx);
    this.drawPoints(ctx);

    if (this.snappedPoint) {
      this.drawSnap(ctx, this.snappedPoint);
    }
  }

  drawGrid(ctx) {
    const gridSpacing = this.scale > 1.5 ? 25 : 50;
    const topLeft = this.screenToWorld(0, 0);
    const bottomRight = this.screenToWorld(this.width, this.height);

    const startE = Math.floor(topLeft.easting / gridSpacing) * gridSpacing;
    const endE = Math.ceil(bottomRight.easting / gridSpacing) * gridSpacing;
    const startN = Math.floor(bottomRight.northing / gridSpacing) * gridSpacing;
    const endN = Math.ceil(topLeft.northing / gridSpacing) * gridSpacing;

    ctx.strokeStyle = "rgba(255, 255, 255, 0.05)";
    ctx.lineWidth = 1;
    ctx.beginPath();

    for (let e = startE; e <= endE; e += gridSpacing) {
      const sp = this.worldToScreen(this.originN, e);
      ctx.moveTo(sp.x, 0); ctx.lineTo(sp.x, this.height);
    }
    for (let n = startN; n <= endN; n += gridSpacing) {
      const sp = this.worldToScreen(n, this.originE);
      ctx.moveTo(0, sp.y); ctx.lineTo(this.width, sp.y);
    }
    ctx.stroke();
  }

  drawLinework(ctx) {
    this.linework.forEach(elem => {
      const layerKey = this.normalizeLayerKey(elem.layer);
      if (this.layers[layerKey] && !this.layers[layerKey].visible) return;

      const pts = elem.points;
      if (!pts || pts.length < 2) return;

      ctx.save();
      ctx.strokeStyle = elem.color || (this.layers[layerKey]?.color) || "#ef4444";
      ctx.lineWidth = elem.lineWidth || 2.0;
      if (elem.dash && elem.dash.length > 0) ctx.setLineDash(elem.dash);

      ctx.beginPath();
      const first = this.worldToScreen(pts[0].n, pts[0].e);
      ctx.moveTo(first.x, first.y);

      for (let i = 1; i < pts.length; i++) {
        const sp = this.worldToScreen(pts[i].n, pts[i].e);
        ctx.lineTo(sp.x, sp.y);
      }

      if (elem.closed) {
        ctx.closePath();
        ctx.fillStyle = elem.color ? elem.color + "18" : "#ffffff18";
        ctx.fill();
      }

      ctx.stroke();

      // Show distance on segments if zoomed
      if (this.scale > 0.45 && pts.length >= 2) {
        const p1 = pts[0];
        const p2 = pts[1];
        const sp = this.worldToScreen((p1.n + p2.n) / 2, (p1.e + p2.e) / 2);
        const dist = Math.hypot(p2.n - p1.n, p2.e - p1.e);

        ctx.fillStyle = "#ffffff";
        ctx.font = "bold 9px 'Roboto Mono', monospace";
        ctx.fillText(`${elem.name || 'LINE'} (${dist.toFixed(1)}')`, sp.x + 4, sp.y - 4);
      }

      ctx.restore();
    });
  }

  drawActive(ctx) {
    if (this.activeVertices.length === 0) return;

    ctx.save();
    const feat = this.features[this.currentFeature] || this.features.BOUNDARY;
    ctx.strokeStyle = feat.color;
    ctx.lineWidth = 2.0;
    ctx.setLineDash([6, 3]);

    ctx.beginPath();
    const first = this.worldToScreen(this.activeVertices[0].n, this.activeVertices[0].e);
    ctx.moveTo(first.x, first.y);

    for (let i = 1; i < this.activeVertices.length; i++) {
      const sp = this.worldToScreen(this.activeVertices[i].n, this.activeVertices[i].e);
      ctx.lineTo(sp.x, sp.y);
    }

    ctx.lineTo(this.cursorScreenX, this.cursorScreenY);
    ctx.stroke();

    ctx.restore();
  }

  drawPoints(ctx) {
    if (!window.pointManager) return;
    if (this.layers.POINTS && !this.layers.POINTS.visible) return;
    const points = window.pointManager.getAll();

    points.forEach(pt => {
      const sp = this.worldToScreen(pt.northing, pt.easting);
      if (sp.x < -20 || sp.x > this.width + 20 || sp.y < -20 || sp.y > this.height + 20) return;

      ctx.save();

      if (pt.type === 'BNDY') {
        // Red circle with cross for boundary corners
        ctx.strokeStyle = "#ef4444";
        ctx.fillStyle = "#ef4444";
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.arc(sp.x, sp.y, 4, 0, 2 * Math.PI);
        ctx.stroke();
      } else if (pt.type === 'CTRL') {
        // Amber triangle for traverse control
        ctx.strokeStyle = "#f59e0b";
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.moveTo(sp.x, sp.y - 5);
        ctx.lineTo(sp.x + 4, sp.y + 4);
        ctx.lineTo(sp.x - 4, sp.y + 4);
        ctx.closePath();
        ctx.stroke();
      } else if (pt.type === 'BM') {
        // Green square for benchmark
        ctx.strokeStyle = "#10b981";
        ctx.lineWidth = 1.5;
        ctx.strokeRect(sp.x - 4, sp.y - 4, 8, 8);
      } else {
        // Standard survey cross
        ctx.strokeStyle = "#38bdf8";
        ctx.lineWidth = 1.2;
        ctx.beginPath();
        ctx.moveTo(sp.x - 3, sp.y - 3); ctx.lineTo(sp.x + 3, sp.y + 3);
        ctx.moveTo(sp.x - 3, sp.y + 3); ctx.lineTo(sp.x + 3, sp.y - 3);
        ctx.stroke();
      }

      ctx.fillStyle = "#ffffff";
      ctx.font = "9px 'Roboto Mono', monospace";
      ctx.fillText(`${pt.code}`, sp.x + 6, sp.y - 3);

      ctx.restore();
    });
  }

  drawSnap(ctx, pt) {
    const sp = this.worldToScreen(pt.northing, pt.easting);
    ctx.save();
    ctx.strokeStyle = "#f59e0b";
    ctx.lineWidth = 2;
    ctx.strokeRect(sp.x - 7, sp.y - 7, 14, 14);

    ctx.fillStyle = "rgba(15, 23, 42, 0.9)";
    ctx.fillRect(sp.x + 10, sp.y - 12, 110, 24);
    ctx.fillStyle = "#ffffff";
    ctx.font = "bold 9px sans-serif";
    ctx.fillText(`PT #${pt.id} (${pt.code})`, sp.x + 14, sp.y + 4);
    ctx.restore();
  }

  // ─────────────────────────────────────────────────────────────────────────────
  // MAGNET Field Linework Code Auto-Builder
  // Parses standard MAGNET Field / Topcon / Sokkia field coding conventions
  // and converts them to Civil 3D-compatible linework layers automatically.
  //
  // MAGNET Field Feature Code Conventions (supported):
  //   EP1 B  or  EP1+   → Begin new string "EP1"
  //   EP1 E  or  EP1-   → End string "EP1"
  //   EP1    or  EP1 C  → Continue string "EP1"
  //   BC     → Begin Curve
  //   EC     → End Curve
  //   PCT    → Point on Curve (no special rendering needed here)
  //
  // Civil 3D Layer Mapping:
  //   EP, EOP, ETP, FL → V-ROAD-CURB   (Edge of Pavement / Curb)
  //   CL, TC, TS       → V-ROAD-CNTR   (Centerline)
  //   IP, BND, LOT, PROP, ROW → V-PROP-LINE (Boundary / Property Line)
  //   BLD, BLDG, FFE   → V-BLDG        (Building Footprint)
  //   WM, WV, GV, SS, MH → V-UTIL-WATR (Utilities)
  //   TBR, TREE, BUSH  → V-SURV-TOPO   (Topo / Vegetation)
  //   BM, TBM, CP      → V-NODE-PNT    (Control / Bench Marks)
  // ─────────────────────────────────────────────────────────────────────────────
  static magnetCodeToLayer(code) {
    if (!code) return 'BOUNDARY';
    const upper = code.trim().toUpperCase().replace(/[+\-]$/, '');
    const tokens = upper.split(/\s+/);
    const c = (tokens[0] === 'B' || tokens[0] === 'E' || tokens[0] === 'C' || tokens[0] === 'CLS') && tokens[1]
      ? tokens[1]
      : tokens[0];

    if (/^(EP|EOP|ETP|FL|CURB|GUTTR)/.test(c)) return 'EOP_CURB';
    if (/^(CL\d*|TC\d*|TS\d*|CNTR|CNTRL)/.test(c)) return 'CENTERLINE';
    if (/^(IP|BND|LOT|PROP|ROW|CORNER|WALL)/.test(c)) return 'BOUNDARY';
    if (/^(FENCE|FNC|GATE)/.test(c)) return 'FIELD_SKETCHES';
    if (/^(BLD|BLDG|FFE|STRUC)/.test(c)) return 'BUILDING';
    if (/^(WM|WV|GV|SS|MH\d*|CO|CB|FH|WTR|GAS|SEWR|STRM|OH|UNK)/.test(c)) return 'UTILITIES';
    return 'BOUNDARY';
  }

  // Build linework automatically from an array of survey points with MAGNET Field codes
  // Supports suffix ("EP1 B", "EP1 E", "EP1+", "EP1-", "BLDG1 CLS") and prefix ("B EP1", "E EP1")
  buildLineworkFromMagnetCodes(points) {
    // Replace any prior auto-generated MAGNET strings so re-running stays clean
    this.linework = this.linework.filter(l => !String(l.id || '').startsWith('magnet-'));

    const strings = {};
    const addedCount = { lines: 0 };

    const commitString = (stringName, s, forceClose = false) => {
      if (!s || s.vertices.length < 2) return;
      const feat = this.features[s.layer] || this.features.BOUNDARY;
      const shouldClose = forceClose || s.closed || (s.layer === 'BUILDING' && s.vertices.length >= 3);
      this.linework.push({
        id: `magnet-${stringName}-${Date.now()}-${addedCount.lines}`,
        layer: feat.c3d || s.layer,
        name: `MAGNET ${stringName}`,
        color: feat.color,
        lineWidth: feat.lineWidth,
        dash: feat.dash || [],
        closed: shouldClose,
        points: [...s.vertices]
      });
      addedCount.lines++;
    };

    points.forEach(pt => {
      const rawCode = (pt.code || '').trim();
      if (!rawCode) return;

      const isPlus = rawCode.endsWith('+');
      const isMinus = rawCode.endsWith('-');
      const cleaned = rawCode.replace(/[+\-]$/, '').trim().toUpperCase();
      const tokens = cleaned.split(/\s+/).filter(Boolean);
      if (tokens.length === 0) return;

      // Pure curve keywords without string tag
      if (tokens.length === 1 && (tokens[0] === 'BC' || tokens[0] === 'EC' || tokens[0] === 'PCT')) return;

      let isBegin = isPlus;
      let isEnd = isMinus;
      let isClose = false;
      let stringTokens = [...tokens];

      // Check suffix action
      const last = stringTokens[stringTokens.length - 1];
      if (stringTokens.length > 1 && /^(B|E|C|CLS|CLOSE)$/.test(last)) {
        if (last === 'B') isBegin = true;
        if (last === 'E') isEnd = true;
        if (last === 'CLS' || last === 'CLOSE') { isEnd = true; isClose = true; }
        stringTokens.pop();
      } else if (stringTokens.length > 1 && /^(B|E|C|CLS)$/.test(stringTokens[0])) {
        // Check prefix action
        const first = stringTokens.shift();
        if (first === 'B') isBegin = true;
        if (first === 'E') isEnd = true;
        if (first === 'CLS') { isEnd = true; isClose = true; }
      }

      // Remove inline BC/EC curve modifiers while preserving string name
      stringTokens = stringTokens.filter(t => t !== 'BC' && t !== 'EC' && t !== 'PCT');
      const stringName = stringTokens.join(' ').trim();
      if (!stringName) return;

      // Skip isolated monument/control/point-only codes unless explicitly given B/E
      if (!isBegin && !isEnd && /^(CP\d*|BM-?\d*|IP\b|FFE|WM|WV|FH|TREE)/.test(stringName)) {
        return;
      }

      const layer = CadEngine.magnetCodeToLayer(stringName);
      const vertex = { id: pt.id, n: pt.northing, e: pt.easting, z: pt.elevation };

      if (isBegin || !strings[stringName]) {
        if (isBegin && strings[stringName] && strings[stringName].vertices.length >= 2) {
          commitString(stringName, strings[stringName], false);
        }
        strings[stringName] = { vertices: [vertex], layer, closed: isClose };
      } else {
        strings[stringName].vertices.push(vertex);
        if (isClose) strings[stringName].closed = true;
      }

      if (isEnd && strings[stringName] && strings[stringName].vertices.length >= 2) {
        commitString(stringName, strings[stringName], isClose);
        delete strings[stringName];
      }
    });

    Object.keys(strings).forEach(sn => {
      commitString(sn, strings[sn], strings[sn].closed);
    });

    this.save();
    this.render();
    this.renderLayerModal();

    const msg = `🗺️ MAGNET Field auto-linework: ${addedCount.lines} Civil 3D figures built from ${points.length} coded points (V-PROP-LINE, V-ROAD-CNTR, V-ROAD-CURB, V-BLDG, V-SITE-FENC).`;
    if (window.aimChat) window.aimChat.postSystemUpdate(msg);
    return addedCount.lines;
  }

  // Build linework from currently loaded points using their field codes
  buildLineworkFromCurrentPoints() {
    if (!window.pointManager) return 0;
    const points = window.pointManager.getAll();
    return this.buildLineworkFromMagnetCodes(points);
  }
}

window.CadEngine = CadEngine;

// --- js/dxf.js ---
// DXF, CSV, GeoJSON, Civil 3D Field Book (.FBK) & Topcon/Sokkia MAGNET Field (.RW5/.RAW) Handler
// Fully compatible with Autodesk Civil 3D 2020-2026, Topcon MAGNET Field / MAGNET Office, & Sokkia
class DxfManager {
  constructor() {
    this.aciColors = {
      BOUNDARY: 1,          // Red
      "V-PROP-LINE": 1,     // Civil 3D Property / Boundary Line (Red)
      CENTERLINE: 2,        // Yellow
      "V-ROAD-CNTR": 2,     // Civil 3D Road Centerline (Yellow)
      UTILITIES_SEWER: 3,   // Green
      "V-UTIL-SSWR": 3,     // Civil 3D Sanitary Sewer (Green)
      UTILITIES_STORM: 4,   // Cyan
      "V-UTIL-STRM": 4,     // Civil 3D Storm Drain (Cyan)
      UTILITIES: 5,         // Blue
      UTILITIES_WATER: 5,   // Blue
      "V-UTIL-WATR": 5,     // Civil 3D Water Main (Blue)
      BUILDING: 6,          // Magenta
      "V-BLDG": 6,          // Civil 3D Building Footprint (Magenta)
      EOP_CURB: 8,          // Dark Gray
      "V-ROAD-CURB": 8,     // Civil 3D Edge of Pavement / Curb (Gray)
      FIELD_SKETCHES: 30,   // Orange
      SKETCH: 30,           // Orange
      "V-SITE-FENC": 30,    // Civil 3D Fence / Site Sketch (Orange)
      "V-TOPO-TREE": 3,     // Civil 3D Trees / Vegetation (Green)
      POINTS: 7,            // White
      "V-NODE-PNT": 7       // Civil 3D Survey Points (White)
    };

    this.civil3dLayerMap = {
      BOUNDARY: "V-PROP-LINE",
      CENTERLINE: "V-ROAD-CNTR",
      EOP_CURB: "V-ROAD-CURB",
      BUILDING: "V-BLDG",
      UTILITIES: "V-UTIL-WATR",
      FIELD_SKETCHES: "V-SITE-FENC",
      SKETCH: "V-SITE-FENC",
      POINTS: "V-NODE-PNT"
    };
  }

  // Map internal layer key or existing Civil 3D layer to a clean Civil 3D NCS DXF layer name
  toCivil3dLayer(layerName) {
    if (!layerName) return "V-PROP-LINE";
    const upper = String(layerName).trim().toUpperCase();
    return this.civil3dLayerMap[upper] || upper;
  }

  _getActiveJobMeta() {
    const job = (window.jobManager && typeof window.jobManager.getCurrentJob === 'function')
      ? window.jobManager.getCurrentJob()
      : (window.SAMPLE_DATA && window.SAMPLE_DATA.jobs ? window.SAMPLE_DATA.jobs[0] : null);
    const equip = (window.app && window.app.equipmentProfile) ? window.app.equipmentProfile : {
      tablet: "Topcon FC-6000",
      software: "MAGNET Field v8.2",
      gps: "Topcon HiPer VR",
      totalStation: "Sokkia iX-1200",
      network: "TopNET Live VRS",
      cadOffice: "Autodesk Civil 3D 2026"
    };
    return {
      jobNum: job ? (job.number || "2026-104") : "2026-104",
      jobDesc: job ? (job.name || "SURVEY JOB") : "SURVEY JOB",
      datum: job ? (job.datum || "NAD83 / NAVD88 (US Survey Feet)") : "NAD83 / NAVD88",
      surveyor: job ? (job.partyChief || "Field Crew") : "Field Crew",
      cadOperator: job ? (job.cadOperator || "Civil 3D Office") : "Civil 3D Office",
      equip
    };
  }

  // Generate ASCII DXF Release 12/2000 file with Civil 3D NCS Layers
  generateDxf(useCivil3dLayers = true) {
    const linework = window.cadEngine ? window.cadEngine.linework : [];
    const points = window.pointManager ? window.pointManager.getAll() : [];

    // Collect all layer names actually needed
    const layerSet = new Set([
      useCivil3dLayers ? "V-NODE-PNT" : "POINTS",
      useCivil3dLayers ? "V-PROP-LINE" : "BOUNDARY",
      useCivil3dLayers ? "V-ROAD-CNTR" : "CENTERLINE",
      useCivil3dLayers ? "V-ROAD-CURB" : "EOP_CURB",
      useCivil3dLayers ? "V-BLDG" : "BUILDING",
      useCivil3dLayers ? "V-UTIL-WATR" : "UTILITIES",
      useCivil3dLayers ? "V-SITE-FENC" : "FIELD_SKETCHES"
    ]);
    linework.forEach(elem => {
      const lyr = useCivil3dLayers ? this.toCivil3dLayer(elem.layer) : (elem.layer || "BOUNDARY");
      layerSet.add(lyr);
    });

    let dxf = "";

    // 1. HEADER SECTION
    dxf += "0\nSECTION\n2\nHEADER\n";
    dxf += "9\n$ACADVER\n1\nAC1009\n"; // AutoCAD R12 standard (broadest Civil 3D compatibility)
    dxf += "9\n$INSUNITS\n70\n2\n";     // 2 = US Survey Feet
    dxf += "0\nENDSEC\n";

    // 2. TABLES SECTION
    dxf += "0\nSECTION\n2\nTABLES\n";
    dxf += `0\nTABLE\n2\nLAYER\n70\n${layerSet.size}\n`;

    layerSet.forEach(layerName => {
      const color = this.aciColors[layerName] || 7;
      dxf += "0\nLAYER\n2\n" + layerName + "\n70\n0\n62\n" + color + "\n6\nCONTINUOUS\n";
    });
    dxf += "0\nENDTAB\n";
    dxf += "0\nENDSEC\n";

    // 3. ENTITIES SECTION
    dxf += "0\nSECTION\n2\nENTITIES\n";

    const ptLayer = useCivil3dLayers ? "V-NODE-PNT" : "POINTS";
    points.forEach(pt => {
      dxf += `0\nPOINT\n8\n${ptLayer}\n`;
      dxf += "10\n" + pt.easting.toFixed(4) + "\n";
      dxf += "20\n" + pt.northing.toFixed(4) + "\n";
      dxf += "30\n" + pt.elevation.toFixed(4) + "\n";

      dxf += `0\nTEXT\n8\n${ptLayer}\n`;
      dxf += "10\n" + (pt.easting + 1.2).toFixed(4) + "\n";
      dxf += "20\n" + (pt.northing + 0.8).toFixed(4) + "\n";
      dxf += "30\n" + pt.elevation.toFixed(4) + "\n";
      dxf += "40\n1.2\n";
      dxf += "1\n" + pt.id + " " + pt.code + "\n";
    });

    linework.forEach(elem => {
      const layer = useCivil3dLayers ? this.toCivil3dLayer(elem.layer) : (elem.layer || "BOUNDARY");
      const pts = elem.points;
      if (!pts || pts.length < 2) return;

      if (elem.type === 'line' && pts.length === 2) {
        dxf += "0\nLINE\n8\n" + layer + "\n";
        dxf += "10\n" + pts[0].e.toFixed(4) + "\n";
        dxf += "20\n" + pts[0].n.toFixed(4) + "\n";
        dxf += "30\n" + (pts[0].z || 0).toFixed(4) + "\n";
        dxf += "11\n" + pts[1].e.toFixed(4) + "\n";
        dxf += "21\n" + pts[1].n.toFixed(4) + "\n";
        dxf += "31\n" + (pts[1].z || 0).toFixed(4) + "\n";
      } else {
        dxf += "0\nPOLYLINE\n8\n" + layer + "\n";
        dxf += "66\n1\n";
        dxf += "70\n" + (elem.closed ? "1" : "0") + "\n";

        pts.forEach(v => {
          dxf += "0\nVERTEX\n8\n" + layer + "\n";
          dxf += "10\n" + v.e.toFixed(4) + "\n";
          dxf += "20\n" + v.n.toFixed(4) + "\n";
          dxf += "30\n" + (v.z || 0).toFixed(4) + "\n";
        });
        dxf += "0\nSEQEND\n";
      }
    });

    dxf += "0\nENDSEC\n0\nEOF\n";
    return dxf;
  }

  downloadDxf(filename) {
    const meta = this._getActiveJobMeta();
    const outName = filename || `JOB_${meta.jobNum}_CIVIL3D.dxf`;
    const dxfContent = this.generateDxf(true);
    this._triggerDownload(dxfContent, outName, "application/dxf;charset=utf-8");
    if (window.soundFX) window.soundFX.playShotBeep();
    if (window.aimChat) {
      window.aimChat.postSystemUpdate(`📤 Civil 3D DXF exported: ${outName} (NCS layers: V-PROP-LINE, V-ROAD-CNTR, V-ROAD-CURB, V-BLDG, V-UTIL-WATR, V-NODE-PNT).`);
    }
  }

  // Parse an uploaded DXF file (supports LINE, 2D/3D POINT, POLYLINE/VERTEX, and Civil 3D LWPOLYLINE)
  parseDxf(content) {
    const lines = content.split(/\r?\n/);
    let inEntities = false;
    let currentEntity = null;
    let currentPolyline = null;

    const importedPoints = [];
    const importedLines = [];

    const layerColorFor = (layer) => {
      const upper = (layer || "BOUNDARY").toUpperCase();
      if (upper.includes("PROP") || upper.includes("BND")) return "#ef4444";
      if (upper.includes("CNTR") || upper.includes("CENTER")) return "#eab308";
      if (upper.includes("CURB") || upper.includes("EOP")) return "#94a3b8";
      if (upper.includes("BLDG") || upper.includes("BUILD")) return "#a855f7";
      if (upper.includes("UTIL") || upper.includes("WATR") || upper.includes("SSWR") || upper.includes("STRM")) return "#0284c7";
      if (upper.includes("FENC") || upper.includes("SKETCH")) return "#f97316";
      return "#ef4444";
    };

    const flushCurrentEntity = () => {
      if (!currentEntity) return;
      if (currentEntity.type === "LINE" && currentEntity.hasStart && currentEntity.hasEnd) {
        importedLines.push({
          id: "dxf-line-" + importedLines.length + "-" + Date.now(),
          layer: currentEntity.layer || "BOUNDARY",
          type: "line",
          name: "DXF " + (currentEntity.layer || "Line"),
          color: layerColorFor(currentEntity.layer),
          lineWidth: 2.0,
          points: [
            { n: currentEntity.y1, e: currentEntity.x1, z: currentEntity.z1 || 0 },
            { n: currentEntity.y2, e: currentEntity.x2, z: currentEntity.z2 || 0 }
          ]
        });
      } else if (currentEntity.type === "POINT" && currentEntity.hasCoords) {
        importedPoints.push({
          id: importedPoints.length + 500,
          northing: currentEntity.y,
          easting: currentEntity.x,
          elevation: currentEntity.z || 0,
          code: currentEntity.layer || "DXF_PT",
          desc: "Imported from Civil 3D DXF"
        });
      } else if (currentEntity.type === "LWPOLYLINE" && currentEntity.points.length >= 2) {
        importedLines.push({
          id: "dxf-lwpoly-" + importedLines.length + "-" + Date.now(),
          layer: currentEntity.layer || "BOUNDARY",
          type: currentEntity.closed ? "polygon" : "polyline",
          name: "DXF " + (currentEntity.layer || "Polyline"),
          color: layerColorFor(currentEntity.layer),
          lineWidth: 2.0,
          closed: currentEntity.closed,
          points: currentEntity.points
        });
      } else if (currentEntity.type === "VERTEX" && currentPolyline && currentEntity.hasCoords) {
        currentPolyline.points.push({
          n: currentEntity.y,
          e: currentEntity.x,
          z: currentEntity.z || 0
        });
      }
      currentEntity = null;
    };

    for (let i = 0; i < lines.length - 1; i += 2) {
      const groupCode = lines[i].trim();
      const val = lines[i + 1] !== undefined ? lines[i + 1].trim() : "";

      if (groupCode === "2" && val === "ENTITIES") {
        inEntities = true;
        continue;
      }
      if (groupCode === "0" && val === "ENDSEC") {
        flushCurrentEntity();
        if (currentPolyline && currentPolyline.points.length >= 2) {
          currentPolyline.color = layerColorFor(currentPolyline.layer);
          importedLines.push(currentPolyline);
          currentPolyline = null;
        }
        inEntities = false;
        continue;
      }

      if (!inEntities) continue;

      if (groupCode === "0") {
        flushCurrentEntity();

        if (val !== "VERTEX" && val !== "SEQEND" && currentPolyline) {
          if (currentPolyline.points.length >= 2) {
            currentPolyline.color = layerColorFor(currentPolyline.layer);
            importedLines.push(currentPolyline);
          }
          currentPolyline = null;
        }

        if (val === "LINE") {
          currentEntity = { type: "LINE", layer: "BOUNDARY", x1: 0, y1: 0, z1: 0, x2: 0, y2: 0, z2: 0, hasStart: false, hasEnd: false };
        } else if (val === "POINT") {
          currentEntity = { type: "POINT", layer: "POINTS", x: 0, y: 0, z: 0, hasCoords: false };
        } else if (val === "POLYLINE") {
          currentPolyline = {
            id: "dxf-poly-" + importedLines.length + "-" + Date.now(),
            type: "polyline",
            layer: "BOUNDARY",
            name: "DXF Polyline",
            lineWidth: 2.0,
            points: [],
            closed: false
          };
          currentEntity = currentPolyline;
        } else if (val === "LWPOLYLINE") {
          currentEntity = { type: "LWPOLYLINE", layer: "BOUNDARY", points: [], closed: false, elev: 0, lastX: undefined };
        } else if (val === "VERTEX") {
          currentEntity = { type: "VERTEX", x: 0, y: 0, z: 0, hasCoords: false };
        } else if (val === "SEQEND") {
          if (currentPolyline && currentPolyline.points.length >= 2) {
            currentPolyline.color = layerColorFor(currentPolyline.layer);
            importedLines.push(currentPolyline);
          }
          currentPolyline = null;
          currentEntity = null;
        }
        continue;
      }

      if (!currentEntity) continue;

      if (groupCode === "8") {
        currentEntity.layer = val;
        if (currentEntity.type === "POLYLINE") {
          currentEntity.name = "DXF " + val;
        }
      } else if (groupCode === "38" && currentEntity.type === "LWPOLYLINE") {
        currentEntity.elev = parseFloat(val) || 0;
      } else if (groupCode === "10") {
        const num = parseFloat(val);
        if (currentEntity.type === "LINE") { currentEntity.x1 = num; currentEntity.hasStart = true; }
        else if (currentEntity.type === "POINT" || currentEntity.type === "VERTEX") { currentEntity.x = num; }
        else if (currentEntity.type === "LWPOLYLINE") { currentEntity.lastX = num; }
      } else if (groupCode === "20") {
        const num = parseFloat(val);
        if (currentEntity.type === "LINE") {
          currentEntity.y1 = num;
        } else if (currentEntity.type === "POINT" || currentEntity.type === "VERTEX") {
          currentEntity.y = num;
          currentEntity.hasCoords = true;
        } else if (currentEntity.type === "LWPOLYLINE" && currentEntity.lastX !== undefined) {
          currentEntity.points.push({
            n: num,
            e: currentEntity.lastX,
            z: currentEntity.elev || 0
          });
          currentEntity.lastX = undefined;
        }
      } else if (groupCode === "30") {
        const num = parseFloat(val) || 0;
        if (currentEntity.type === "LINE") currentEntity.z1 = num;
        else currentEntity.z = num;
      } else if (groupCode === "11" && currentEntity.type === "LINE") {
        currentEntity.x2 = parseFloat(val);
        currentEntity.hasEnd = true;
      } else if (groupCode === "21" && currentEntity.type === "LINE") {
        currentEntity.y2 = parseFloat(val);
      } else if (groupCode === "31" && currentEntity.type === "LINE") {
        currentEntity.z2 = parseFloat(val) || 0;
      } else if (groupCode === "70" && (currentEntity.type === "POLYLINE" || currentEntity.type === "LWPOLYLINE")) {
        const flag = parseInt(val, 10);
        if (flag & 1) currentEntity.closed = true;
      }
    }

    flushCurrentEntity();
    if (currentPolyline && currentPolyline.points.length >= 2) {
      currentPolyline.color = layerColorFor(currentPolyline.layer);
      importedLines.push(currentPolyline);
    }

    return { points: importedPoints, linework: importedLines };
  }

  // Export Survey Points to Civil 3D / MAGNET Field PNEZD CSV
  exportCsv(filename) {
    const meta = this._getActiveJobMeta();
    const outName = filename || `JOB_${meta.jobNum}_PNEZD.csv`;
    const points = window.pointManager ? window.pointManager.getAll() : [];
    let csv = "PointID,Northing,Easting,Elevation,Code,Description,RodHeight\n";

    points.forEach(p => {
      const safeCode = String(p.code || "").replace(/"/g, '""');
      const safeDesc = String(p.desc || "").replace(/"/g, '""');
      csv += `${p.id},${p.northing.toFixed(4)},${p.easting.toFixed(4)},${p.elevation.toFixed(4)},"${safeCode}","${safeDesc}",${(p.hr || 5.0).toFixed(3)}\n`;
    });

    this._triggerDownload(csv, outName, "text/csv;charset=utf-8");
    if (window.soundFX) window.soundFX.playShotBeep();
    if (window.aimChat) {
      window.aimChat.postSystemUpdate(`📤 PNEZD CSV exported: ${outName} (${points.length} pts) — Compatible with Civil 3D & MAGNET Field.`);
    }
  }

  // Parse CSV/TXT ASCII PNEZD (handles quoted CSV fields, tab, or space delimited)
  parseCsv(content) {
    const lines = content.trim().split(/\r?\n/);
    const parsedPoints = [];

    const splitCsvRow = (row) => {
      const out = [];
      let cur = "";
      let inQuotes = false;
      for (let i = 0; i < row.length; i++) {
        const ch = row[i];
        if (ch === '"') {
          inQuotes = !inQuotes;
        } else if (ch === ',' && !inQuotes) {
          out.push(cur.trim());
          cur = "";
        } else {
          cur += ch;
        }
      }
      out.push(cur.trim());
      return out;
    };

    lines.forEach((line, index) => {
      const clean = line.trim();
      if (!clean || clean.startsWith("//") || clean.startsWith("#")) return;

      let parts = [];
      if (clean.includes(",")) {
        parts = splitCsvRow(clean);
      } else if (clean.includes("\t")) {
        parts = clean.split("\t").map(s => s.trim());
      } else {
        parts = clean.split(/\s+/);
      }

      if (index === 0 && (isNaN(Number(parts[1])) || isNaN(Number(parts[2])))) {
        return;
      }

      if (parts.length >= 4) {
        const id = parts[0];
        const n = parseFloat(parts[1]);
        const e = parseFloat(parts[2]);
        const z = parseFloat(parts[3]) || 0;
        const code = parts[4] || "SHOT";
        let desc = "";
        let hr = 5.0;
        if (parts.length >= 7 && !isNaN(Number(parts[parts.length - 1]))) {
          hr = parseFloat(parts[parts.length - 1]);
          desc = parts.slice(5, parts.length - 1).join(" ");
        } else {
          desc = parts.slice(5).join(" ") || "";
        }

        if (!isNaN(n) && !isNaN(e)) {
          parsedPoints.push({
            id: isNaN(Number(id)) ? index + 1 : Number(id),
            northing: n,
            easting: e,
            elevation: z,
            code,
            desc,
            hr
          });
        }
      }
    });

    return parsedPoints;
  }

  exportGeoJson(filename) {
    const meta = this._getActiveJobMeta();
    const outName = filename || `JOB_${meta.jobNum}.geojson`;
    const linework = window.cadEngine ? window.cadEngine.linework : [];
    const points = window.pointManager ? window.pointManager.getAll() : [];

    const features = [];

    points.forEach(p => {
      features.push({
        type: "Feature",
        geometry: {
          type: "Point",
          coordinates: [p.easting, p.northing, p.elevation]
        },
        properties: {
          id: p.id,
          code: p.code,
          elevation: p.elevation,
          desc: p.desc || ""
        }
      });
    });

    linework.forEach(l => {
      if (!l.points || l.points.length < 2) return;

      if (l.closed || l.type === 'polygon' || l.type === 'parcel') {
        const ring = l.points.map(pt => [pt.e, pt.n, pt.z || 0]);
        if (ring[0][0] !== ring[ring.length - 1][0] || ring[0][1] !== ring[ring.length - 1][1]) {
          ring.push([...ring[0]]);
        }
        features.push({
          type: "Feature",
          geometry: { type: "Polygon", coordinates: [ring] },
          properties: { id: l.id, name: l.name, layer: this.toCivil3dLayer(l.layer) }
        });
      } else {
        features.push({
          type: "Feature",
          geometry: { type: "LineString", coordinates: l.points.map(pt => [pt.e, pt.n, pt.z || 0]) },
          properties: { id: l.id, name: l.name, layer: this.toCivil3dLayer(l.layer) }
        });
      }
    });

    const geoJson = {
      type: "FeatureCollection",
      properties: {
        job: meta.jobNum,
        datum: meta.datum,
        exportedAt: new Date().toISOString()
      },
      features
    };

    this._triggerDownload(JSON.stringify(geoJson, null, 2), outName, "application/geo+json");
    if (window.soundFX) window.soundFX.playShotBeep();
  }

  exportPngSnapshot(filename = "SURVEY_DRAWING.png") {
    const canvas = document.getElementById('cad-canvas');
    if (!canvas) return;
    const dataUrl = canvas.toDataURL("image/png");
    const a = document.createElement("a");
    a.href = dataUrl;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    if (window.soundFX) window.soundFX.playShotBeep();
  }

  // ─────────────────────────────────────────────────────────────────────────────
  // Civil 3D Survey Database Field Book (.FBK) Generator & Importer
  // Compatible with: Autodesk Civil 3D 2020-2026 Survey Database Import Wizard
  // ─────────────────────────────────────────────────────────────────────────────
  generateCivil3dFbkContent() {
    const points = window.pointManager ? window.pointManager.getAll() : [];
    const linework = window.cadEngine ? window.cadEngine.linework : [];
    const meta = this._getActiveJobMeta();
    const today = new Date();
    const dateStr = `${today.getMonth() + 1}/${today.getDate()}/${today.getFullYear()}`;
    const filename = `JOB_${meta.jobNum}_C3D.fbk`;

    let fbk = "";
    fbk += `! Civil 3D Survey Field Book (.FBK)\n`;
    fbk += `! Generated by GeoSurvey Pro (MAGNET Field to Civil 3D Bridge)\n`;
    fbk += `! Job: ${meta.jobNum} - ${meta.jobDesc}\n`;
    fbk += `! Date: ${dateStr}  Party Chief: ${meta.surveyor}  CAD: ${meta.cadOperator}\n`;
    fbk += `! Hardware: ${meta.equip.tablet} | ${meta.equip.software} | ${meta.equip.gps} | ${meta.equip.totalStation}\n`;
    fbk += `! Datum: ${meta.datum}\n`;
    fbk += `!\n`;
    fbk += `JOB ${meta.jobNum}\n`;
    fbk += `UNIT FOOT US\n`;
    fbk += `HORIZ ANGLE RIGHT\n`;
    fbk += `VERT ANGLE ZENITH\n`;
    fbk += `SCALE 1.00000000\n`;
    fbk += `!\n`;

    const ctrlPts = points.filter(p => p.type === 'CTRL' || p.type === 'BM');
    if (ctrlPts.length > 0) {
      fbk += `! ── Control Points & Benchmarks (CR NEZ) ─────────────────────────\n`;
      ctrlPts.forEach(pt => {
        const note = `${pt.code} ${pt.desc || ''}`.trim();
        fbk += `CR NEZ ${pt.id} ${pt.northing.toFixed(4)} ${pt.easting.toFixed(4)} ${pt.elevation.toFixed(4)} "${note}"\n`;
      });
      fbk += `!\n`;
    }

    const defaultRod = points.find(p => p.hr)?.hr || 6.562;
    fbk += `PRISM ${Number(defaultRod).toFixed(3)}\n`;
    fbk += `!\n`;

    if (ctrlPts.length > 0) {
      fbk += `! ── Station Setup (${meta.equip.totalStation}) ───────────────────────\n`;
      fbk += `STN ${ctrlPts[0].id} ${(ctrlPts[0].hi || 5.120).toFixed(3)}\n`;
      if (ctrlPts.length > 1) {
        fbk += `BS ${ctrlPts[1].id}\n`;
      }
      fbk += `!\n`;
    }

    const sideShots = points.filter(p => p.type !== 'CTRL' && p.type !== 'BM');
    if (sideShots.length > 0) {
      fbk += `! ── Survey Points (NEZ with MAGNET Field Descriptions) ───────────\n`;
      sideShots.forEach(pt => {
        const rod = Number(pt.hr || defaultRod).toFixed(3);
        const note = `${pt.code}${pt.desc ? ' / ' + pt.desc : ''}`;
        fbk += `! HR=${rod}  CODE=${pt.code}\n`;
        fbk += `NEZ ${pt.id} ${pt.northing.toFixed(4)} ${pt.easting.toFixed(4)} ${pt.elevation.toFixed(4)} "${note}"\n`;
      });
      fbk += `!\n`;
    }

    // Export Civil 3D Survey Figures (BEG / CONT / CLOSE / END) from linework
    if (linework.length > 0) {
      fbk += `! ── Civil 3D Survey Figures (Figure Prefix Database) ─────────────\n`;
      let figPtCounter = 9000;
      linework.forEach((elem, idx) => {
        if (!elem.points || elem.points.length < 2) return;
        const c3dLayer = this.toCivil3dLayer(elem.layer);
        const figName = (elem.name || c3dLayer).replace(/[^A-Za-z0-9_-]/g, '_').slice(0, 24) + `_${idx + 1}`;
        fbk += `! Layer: ${c3dLayer}\n`;
        fbk += `BEG ${figName}\n`;
        elem.points.forEach(v => {
          if (v.id) {
            fbk += `CONT ${v.id}\n`;
          } else {
            figPtCounter++;
            fbk += `NEZ ${figPtCounter} ${Number(v.n).toFixed(4)} ${Number(v.e).toFixed(4)} ${Number(v.z || 0).toFixed(4)} "${c3dLayer}"\n`;
          }
        });
        fbk += elem.closed ? `CLOSE\n` : `END\n`;
      });
      fbk += `!\n`;
    }

    fbk += `END\n`;
    return { filename, content: fbk, pointCount: points.length, sideShotCount: sideShots.length, figureCount: linework.length };
  }

  exportCivil3dFbk(filename) {
    const res = this.generateCivil3dFbkContent();
    const outName = filename || res.filename;
    this._triggerDownload(res.content, outName, "text/plain;charset=utf-8");
    if (window.soundFX) window.soundFX.playShotBeep();

    if (window.aimChat) {
      window.aimChat.postSystemUpdate(
        `📤 Civil 3D .FBK exported: ${outName} (${res.pointCount} pts, ${res.figureCount} Civil 3D Survey Figures) — Ready for Civil 3D Survey Database Import.`
      );
    }
    return res;
  }

  // Parse an uploaded Autodesk Civil 3D Field Book (.FBK)
  parseCivil3dFbk(content) {
    const lines = content.split(/\r?\n/);
    const pointsMap = new Map();
    const figures = [];
    let currentFigure = null;
    let currentRod = 5.0;

    lines.forEach(rawLine => {
      const line = rawLine.trim();
      if (!line || line.startsWith("!")) return;

      // Strip inline comment after !
      const bangIdx = line.indexOf("!");
      const clean = (bangIdx >= 0 ? line.slice(0, bangIdx) : line).trim();
      if (!clean) return;

      // Extract quoted description if present
      let quotedDesc = "";
      let mainPart = clean;
      const qMatch = clean.match(/"([^"]*)"/);
      if (qMatch) {
        quotedDesc = qMatch[1].trim();
        mainPart = clean.replace(qMatch[0], "").trim();
      }

      const tokens = mainPart.split(/\s+/);
      const cmd = (tokens[0] || "").toUpperCase();

      if (cmd === "PRISM" && tokens[1]) {
        const val = parseFloat(tokens[1]);
        if (!isNaN(val)) currentRod = val;
      } else if (cmd === "CR" && (tokens[1] || "").toUpperCase() === "NEZ" && tokens.length >= 6) {
        const id = Number(tokens[2]) || tokens[2];
        const n = parseFloat(tokens[3]);
        const e = parseFloat(tokens[4]);
        const z = parseFloat(tokens[5]) || 0;
        if (!isNaN(n) && !isNaN(e)) {
          const code = quotedDesc ? quotedDesc.split(/[\s/]+/)[0] : "CTRL";
          const pt = { id, northing: n, easting: e, elevation: z, code, desc: quotedDesc || "Civil 3D Control", hr: currentRod, type: "CTRL" };
          pointsMap.set(String(id), pt);
        }
      } else if ((cmd === "NEZ" || cmd === "PNEZD") && tokens.length >= 5) {
        const id = Number(tokens[1]) || tokens[1];
        const n = parseFloat(tokens[2]);
        const e = parseFloat(tokens[3]);
        const z = parseFloat(tokens[4]) || 0;
        const tailDesc = tokens.slice(5).join(" ");
        const fullDesc = quotedDesc || tailDesc || "FBK_PT";
        const code = fullDesc.split("/")[0].trim() || "FBK_PT";
        if (!isNaN(n) && !isNaN(e)) {
          const pt = { id, northing: n, easting: e, elevation: z, code, desc: fullDesc, hr: currentRod };
          pointsMap.set(String(id), pt);
          if (currentFigure) {
            currentFigure.vertices.push({ id: Number(id) || null, n, e, z });
          }
        }
      } else if (cmd === "SS" && tokens.length >= 5 && !isNaN(parseFloat(tokens[2])) && !isNaN(parseFloat(tokens[3]))) {
        // Coordinate-style SS record
        const id = Number(tokens[1]) || tokens[1];
        const n = parseFloat(tokens[2]);
        const e = parseFloat(tokens[3]);
        const z = parseFloat(tokens[4]) || 0;
        const hr = tokens[5] && !isNaN(parseFloat(tokens[5])) ? parseFloat(tokens[5]) : currentRod;
        const code = tokens[6] || quotedDesc || "SHOT";
        pointsMap.set(String(id), { id, northing: n, easting: e, elevation: z, code, desc: quotedDesc || code, hr });
      } else if (cmd === "BEG" && tokens[1]) {
        currentFigure = {
          name: tokens[1],
          vertices: []
        };
      } else if (cmd === "CONT" && tokens[1] && currentFigure) {
        const ref = pointsMap.get(String(tokens[1]));
        if (ref) {
          currentFigure.vertices.push({ id: ref.id, n: ref.northing, e: ref.easting, z: ref.elevation });
        }
      } else if ((cmd === "END" || cmd === "CLOSE") && currentFigure) {
        if (currentFigure.vertices.length >= 2) {
          const layer = window.CadEngine ? window.CadEngine.magnetCodeToLayer(currentFigure.name) : "BOUNDARY";
          figures.push({
            id: "fbk-fig-" + figures.length + "-" + Date.now(),
            layer,
            name: currentFigure.name,
            closed: cmd === "CLOSE",
            points: currentFigure.vertices
          });
        }
        currentFigure = null;
      }
    });

    return { points: Array.from(pointsMap.values()), linework: figures };
  }

  // ─────────────────────────────────────────────────────────────────────────────
  // Topcon / Sokkia MAGNET Field Raw File (.RW5 / .RAW) Generator & Importer
  // Importable by MAGNET Field, MAGNET Office, and Sokkia SDR/RW5 tools
  // ─────────────────────────────────────────────────────────────────────────────
  generateMagnetRawContent() {
    const points = window.pointManager ? window.pointManager.getAll() : [];
    const meta = this._getActiveJobMeta();
    const today = new Date();
    const dateStr = `${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}-${today.getFullYear()}`;
    const timeStr = `${String(today.getHours()).padStart(2, '0')}:${String(today.getMinutes()).padStart(2, '0')}:${String(today.getSeconds()).padStart(2, '0')}`;
    const filename = `JOB_${meta.jobNum}.rw5`;

    let rw5 = "";
    rw5 += `--Rw5 2.0 Topcon/Sokkia MAGNET Field Compatible Raw File\n`;
    rw5 += `--Job: ${meta.jobNum}\n`;
    rw5 += `--Date: ${dateStr}\n`;
    rw5 += `--Time: ${timeStr}\n`;
    rw5 += `--Controller: ${meta.equip.tablet} | Software: ${meta.equip.software}\n`;
    rw5 += `--Receiver: ${meta.equip.gps} | Total Station: ${meta.equip.totalStation}\n`;
    rw5 += `--Description: ${meta.jobDesc}\n`;
    rw5 += `MO,AD0,UN0,SF1.00000000,EC1,EO0.0,AU0\n`;

    const ctrlPts = points.filter(p => p.type === 'CTRL' || p.type === 'BM');
    ctrlPts.forEach(pt => {
      rw5 += `KP,PN${pt.id},N ${pt.northing.toFixed(4)},E ${pt.easting.toFixed(4)},EL${pt.elevation.toFixed(4)},--${pt.code}${pt.desc ? ' ' + pt.desc : ''}\n`;
    });

    if (ctrlPts.length > 0) {
      const hi = Number(ctrlPts[0].hi || 5.12).toFixed(4);
      const hr = Number(ctrlPts[0].hr || 5.00).toFixed(4);
      rw5 += `OC,OP${ctrlPts[0].id},N ${ctrlPts[0].northing.toFixed(4)},E ${ctrlPts[0].easting.toFixed(4)},EL${ctrlPts[0].elevation.toFixed(4)},--Occupied Control\n`;
      rw5 += `LS,HI${hi},HR${hr}\n`;
    }
    if (ctrlPts.length > 1) {
      rw5 += `BK,OP${ctrlPts[0].id},BP${ctrlPts[1].id},BS0.0000,BC0.0000,--Backsight Check\n`;
    }

    const sideShots = points.filter(p => p.type !== 'CTRL' && p.type !== 'BM');
    let lastHr = null;
    sideShots.forEach(pt => {
      const hr = Number(pt.hr || 6.562).toFixed(4);
      if (hr !== lastHr) {
        rw5 += `LS,HR${hr}\n`;
        lastHr = hr;
      }
      rw5 += `SP,PN${pt.id},N ${pt.northing.toFixed(4)},E ${pt.easting.toFixed(4)},EL${pt.elevation.toFixed(4)},--${pt.code}${pt.desc ? ' ' + pt.desc : ''}\n`;
    });

    rw5 += `--GNSS RTK Session | ${meta.equip.gps} | ${meta.equip.network} | Sats:24 | PDOP:1.05\n`;
    sideShots.forEach(pt => {
      rw5 += `GPS,PN${pt.id},LA0.000000,LN0.000000,EL${pt.elevation.toFixed(4)},N ${pt.northing.toFixed(4)},E ${pt.easting.toFixed(4)},--${pt.code}\n`;
    });

    return { filename, content: rw5, pointCount: points.length };
  }

  exportMagnetRaw(filename) {
    const res = this.generateMagnetRawContent();
    const outName = filename || res.filename;
    this._triggerDownload(res.content, outName, "text/plain;charset=utf-8");
    if (window.soundFX) window.soundFX.playShotBeep();

    if (window.aimChat) {
      window.aimChat.postSystemUpdate(
        `📤 MAGNET Field .RW5 exported: ${outName} (${res.pointCount} pts) — Ready for Topcon MAGNET Field / MAGNET Office.`
      );
    }
    return res;
  }

  // Parse an uploaded Topcon / Sokkia MAGNET Field (.RW5 / .RAW) file
  parseMagnetRaw(content) {
    const lines = content.split(/\r?\n/);
    const pointsMap = new Map();
    const metadata = {};
    let currentHr = 5.0;

    lines.forEach(rawLine => {
      const line = rawLine.trim();
      if (!line) return;

      if (line.startsWith("--")) {
        const metaMatch = line.match(/^--([A-Za-z]+):\s*(.+)$/);
        if (metaMatch) metadata[metaMatch[1].toLowerCase()] = metaMatch[2].trim();
        return;
      }

      const parts = line.split(",");
      const recType = (parts[0] || "").trim().toUpperCase();

      if (recType === "LS") {
        parts.slice(1).forEach(tok => {
          const t = tok.trim();
          if (t.toUpperCase().startsWith("HR")) {
            const val = parseFloat(t.slice(2));
            if (!isNaN(val)) currentHr = val;
          }
        });
        return;
      }

      if (recType === "KP" || recType === "SP" || recType === "OC" || recType === "GPS") {
        let pn = null, n = NaN, e = NaN, el = 0, note = "";
        parts.slice(1).forEach(tok => {
          const t = tok.trim();
          const up = t.toUpperCase();
          if (up.startsWith("PN")) pn = t.slice(2).trim();
          else if (up.startsWith("OP") && !pn) pn = t.slice(2).trim();
          else if (up.startsWith("N ") || /^N[-0-9.]/.test(up)) n = parseFloat(t.slice(1).trim());
          else if (up.startsWith("E ") || /^E[-0-9.]/.test(up)) e = parseFloat(t.slice(1).trim());
          else if (up.startsWith("EL")) el = parseFloat(t.slice(2).trim()) || 0;
          else if (t.startsWith("--")) note = t.slice(2).trim();
        });

        if (pn !== null && !isNaN(n) && !isNaN(e)) {
          const numericId = isNaN(Number(pn)) ? pn : Number(pn);
          const tokens = note.split(/\s+/).filter(Boolean);
          // Preserve MAGNET Field linework suffix (e.g. "EP1 B" or "CL1 E") if present
          let code = "MAG_PT";
          let desc = note;
          if (tokens.length >= 2 && /^(B|E|C|CLS)$/i.test(tokens[1])) {
            code = `${tokens[0]} ${tokens[1]}`.toUpperCase();
            desc = tokens.slice(2).join(" ");
          } else if (tokens.length >= 1) {
            code = tokens[0].toUpperCase();
            desc = tokens.slice(1).join(" ");
          }

          const existing = pointsMap.get(String(numericId));
          pointsMap.set(String(numericId), {
            id: numericId,
            northing: n,
            easting: e,
            elevation: el,
            code: existing && code === "MAG_PT" ? existing.code : code,
            desc: desc || (existing ? existing.desc : "Imported from MAGNET .RW5"),
            hr: currentHr,
            type: recType === "KP" || recType === "OC" ? "CTRL" : undefined
          });
        }
      }
    });

    return { points: Array.from(pointsMap.values()), metadata };
  }

  _triggerDownload(content, filename, mimeType) {
    const blob = new Blob([content], { type: mimeType });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }
}

window.DxfManager = DxfManager;
window.dxfManager = new DxfManager();

// --- js/fieldbook.js ---
// Digital Land Surveying Field Book Engine (Transit Book, Level Loop & Boundary Notes)
class FieldBook {
  constructor() {
    this.notes = null;
    this.sketchCanvas = null;
    this.sketchCtx = null;
    this.currentSubTab = 'book'; // 'book', 'traverse', 'boundary', 'stakeout', 'media'
    this.activeStakeoutPtId = 10;
    this.photos = [];
    this.voiceMemos = [];
    this.traverseData = [
      { from: "CP1", to: "CP2", dist: 305.82, bearing: "N 37° 15' 00\" E", dN: 243.43, dE: 185.12 },
      { from: "CP2", to: "CP3", dist: 306.15, bearing: "N 59° 48' 20\" E", dN: 153.94, dE: 264.48 },
      { from: "CP3", to: "CP4", dist: 284.28, bearing: "S 12° 28' 10\" E", dN: -277.58, dE: 61.39 },
      { from: "CP4", to: "CP1", dist: 524.45, bearing: "S 76° 49' 40\" W", dN: -119.77, dE: -510.98 }
    ];
  }

  init(initialNotes) {
    const saved = localStorage.getItem('survey_field_notes');
    if (saved) {
      try {
        this.notes = JSON.parse(saved);
      } catch (e) {
        this.notes = initialNotes ? { ...initialNotes } : {};
      }
    } else {
      this.notes = initialNotes ? { ...initialNotes } : {};
    }

    // Ensure hardware & monuments exist when migrating older stored field notes
    if (initialNotes) {
      if (!this.notes.hardware && initialNotes.hardware) {
        this.notes.hardware = { ...initialNotes.hardware };
      }
      if (!this.notes.monuments && initialNotes.monuments) {
        this.notes.monuments = [...initialNotes.monuments];
      }
      if (!this.notes.instrumentCheck && initialNotes.instrumentCheck) {
        this.notes.instrumentCheck = { ...initialNotes.instrumentCheck };
      }
    }

    const savedPhotos = localStorage.getItem('survey_field_photos');
    if (savedPhotos) {
      try { this.photos = JSON.parse(savedPhotos); } catch (e) {}
    } else {
      this.photos = [
        {
          id: "photo-1",
          title: "SW Lot Corner 1/2\" Iron Rod",
          pointId: 10,
          bearing: "N 45° E",
          time: "08:42 AM",
          notes: "Found 1/2\" iron rod flush with grade, 2.1' east of water meter box."
        },
        {
          id: "photo-2",
          title: "NW Property Corner 5/8\" Rebar",
          pointId: 11,
          bearing: "N 12° W",
          time: "09:15 AM",
          notes: "Found 5/8\" iron rod flush with ground in fence line."
        }
      ];
    }

    const savedMemos = localStorage.getItem('survey_voice_memos');
    if (savedMemos) {
      try { this.voiceMemos = JSON.parse(savedMemos); } catch (e) {}
    } else {
      this.voiceMemos = [
        {
          id: "memo-1",
          title: "SW Corner Water Meter Verification",
          duration: "0:18",
          time: "08:44 AM",
          transcript: "Point 10 is 2.1 feet east of the water meter vault. Encroachment conflict cleared. Boundary line is free of utilities."
        }
      ];
    }

    this.computeLevelLoopStatsOnly();
    this.renderFieldBook();
  }

  save() {
    localStorage.setItem('survey_field_notes', JSON.stringify(this.notes));
    localStorage.setItem('survey_field_photos', JSON.stringify(this.photos));
    localStorage.setItem('survey_voice_memos', JSON.stringify(this.voiceMemos));
  }

  setSubTab(tab) {
    this.currentSubTab = tab;
    this.renderFieldBook();
  }

  renderFieldBook() {
    const container = document.getElementById('fieldbook-container');
    if (!container || !this.notes) return;

    const n = this.notes;

    container.innerHTML = `
      <div class="fieldbook-wrapper">
        <!-- Field Book Top Navigation Bar -->
        <div class="fieldbook-topbar">
          <div class="fb-title">
            <span class="fb-badge">FIELD BOOK #${n.bookNumber || 'FB-01'}</span>
            <span class="fb-page">PAGE ${n.pageNumber || 42}</span>
            <h3>${n.projectName || 'Project Survey Notes'}</h3>
          </div>

          <!-- Section Switcher Tabs -->
          <div class="fb-subnav-buttons">
            <button class="btn btn-xs ${this.currentSubTab === 'book' ? 'btn-primary' : 'btn-outline-light'}" onclick="window.fieldBook.setSubTab('book')">
              📖 Transit & Level Book
            </button>
            <button class="btn btn-xs ${this.currentSubTab === 'traverse' ? 'btn-primary' : 'btn-outline-light'}" onclick="window.fieldBook.setSubTab('traverse')">
              🔄 Traverse Loop Balance
            </button>
            <button class="btn btn-xs ${this.currentSubTab === 'boundary' ? 'btn-primary' : 'btn-outline-light'}" onclick="window.fieldBook.setSubTab('boundary')">
              📍 Boundary & Monuments
            </button>
            <button class="btn btn-xs ${this.currentSubTab === 'stakeout' ? 'btn-primary' : 'btn-outline-light'}" onclick="window.fieldBook.setSubTab('stakeout')">
              🎯 Stakeout Navigator
            </button>
            <button class="btn btn-xs ${this.currentSubTab === 'media' ? 'btn-primary' : 'btn-outline-light'}" onclick="window.fieldBook.setSubTab('media')">
              📷 Photos & Voice Notes
            </button>
          </div>

          <div class="fb-actions">
            <button class="btn btn-xs btn-outline-warning" onclick="window.print()">🖨️ Print Book</button>
            <button class="btn btn-xs btn-success" onclick="window.fieldBook.saveNotesFromForm()">💾 Save</button>
          </div>
        </div>

        <!-- 1. CLASSIC 2-PAGE YELLOW TRANSIT BOOK SPREAD -->
        ${this.currentSubTab === 'book' ? this.renderTransitBookSpread() : ''}

        <!-- 2. TRAVERSE LOOP BALANCING (COMPASS RULE / BOWDITCH) -->
        ${this.currentSubTab === 'traverse' ? this.renderTraverseSection() : ''}

        <!-- 3. BOUNDARY CORNER & MONUMENT RECOVERY SHEET -->
        ${this.currentSubTab === 'boundary' ? this.renderBoundarySection() : ''}

        <!-- 4. STAKEOUT NAVIGATOR -->
        ${this.currentSubTab === 'stakeout' ? this.renderStakeoutSection() : ''}

        <!-- 5. PHOTOS & VOICE MEMOS -->
        ${this.currentSubTab === 'media' ? this.renderMediaSection() : ''}
      </div>
    `;

    if (this.currentSubTab === 'book') {
      this.initSketchCanvas();
    }
  }

  // Classic 2-Page Yellow Grid Transit & Level Book
  renderTransitBookSpread() {
    const n = this.notes;
    return `
      <div class="fieldbook-spread">
        <!-- LEFT PAGE: TABULAR DATA & LEVEL LOOP -->
        <div class="fieldbook-page left-page">
          <div class="page-header-row">
            <span class="page-date">DATE: <input type="date" id="fb-date" value="${n.date || '2026-11-23'}"></span>
            <span class="page-title-left">DIFFERENTIAL LEVEL & BENCHMARK TIES</span>
          </div>

          <div class="fb-table-container">
            <table class="fb-table">
              <thead>
                <tr>
                  <th>STATION / PT</th>
                  <th>BS (+)</th>
                  <th>H.I.</th>
                  <th>FS (-)</th>
                  <th>ELEV (FT)</th>
                  <th>REMARKS / CODE</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                ${(n.levelLoop || []).map((row, idx) => `
                  <tr>
                    <td><input type="text" class="fb-cell" value="${row.station || ''}" onchange="window.fieldBook.updateRow(${idx}, 'station', this.value)"></td>
                    <td><input type="number" step="0.001" class="fb-cell text-right" value="${row.bs !== null ? row.bs : ''}" onchange="window.fieldBook.updateRow(${idx}, 'bs', this.value)"></td>
                    <td><span class="fb-cell-readonly">${row.hi ? row.hi.toFixed(3) : '-'}</span></td>
                    <td><input type="number" step="0.001" class="fb-cell text-right" value="${row.fs !== null ? row.fs : ''}" onchange="window.fieldBook.updateRow(${idx}, 'fs', this.value)"></td>
                    <td><span class="fb-cell-readonly font-bold">${row.elev ? row.elev.toFixed(3) : '-'}</span></td>
                    <td><input type="text" class="fb-cell" value="${row.remarks || ''}" onchange="window.fieldBook.updateRow(${idx}, 'remarks', this.value)"></td>
                    <td><button class="fb-del-btn" onclick="window.fieldBook.deleteRow(${idx})">×</button></td>
                  </tr>
                `).join('')}
              </tbody>
            </table>
          </div>

          <div class="fb-table-controls">
            <button class="btn btn-xs btn-outline-primary" onclick="window.fieldBook.addRow()">+ Add Turning Point</button>
            <button class="btn btn-xs btn-outline-success" onclick="window.fieldBook.calculateLevelLoop()">⚡ Compute Page Check</button>
          </div>

          <div class="level-closure-box">
            ${this.getLevelLoopSummaryHTML()}
          </div>
        </div>

        <!-- RIGHT PAGE: CREW, WEATHER, INSTRUMENT, SKETCH -->
        <div class="fieldbook-page right-page">
          <div class="page-header-row">
            <span class="page-title-right">CREW & INSTRUMENT ALIGNMENT NOTES</span>
            <span class="notes-by">RECORDER: <input type="text" id="fb-notes-by" value="${n.crew?.notesBy || 'M.K.'}"></span>
          </div>

          <div class="fb-meta-grid">
            <div class="fb-meta-group"><label>Party Chief:</label><input type="text" id="fb-party-chief" value="${n.crew?.partyChief || ''}"></div>
            <div class="fb-meta-group"><label>Instrument Operator:</label><input type="text" id="fb-instrument-op" value="${n.crew?.instrument || ''}"></div>
            <div class="fb-meta-group"><label>Rodperson:</label><input type="text" id="fb-rodperson" value="${n.crew?.rodperson || ''}"></div>
            <div class="fb-meta-group"><label>Weather & Temp:</label><input type="text" id="fb-weather" value="${n.weather?.temp || '72°F'}, ${n.weather?.conditions || 'Clear'}"></div>
            <div class="fb-meta-group"><label>Barometric Pressure:</label><input type="text" id="fb-pressure" value="${n.weather?.pressure || '30.08 inHg'}"></div>
            <div class="fb-meta-group"><label>Instrument Check:</label><input type="text" id="fb-instr-check" value="${n.instrumentCheck?.model || ''} - ${n.instrumentCheck?.collimationCheck || 'PASSED'}"></div>
            <div class="fb-meta-group"><label>Field Tablet & Software:</label><input type="text" id="fb-hw-tablet" value="${(window.app?.equipmentProfile?.tablet || n.hardware?.tablet || 'Topcon FC-6000')} / ${(window.app?.equipmentProfile?.software || n.hardware?.software || 'MAGNET Field v8.2')}"></div>
            <div class="fb-meta-group"><label>GNSS & Total Station:</label><input type="text" id="fb-hw-gear" value="${(window.app?.equipmentProfile?.gps || n.hardware?.gps || 'Topcon HiPer VR')} • ${(window.app?.equipmentProfile?.totalStation || n.hardware?.robot || 'Sokkia iX-1200')}"></div>
          </div>

          <div class="fb-sketch-wrapper">
            <div class="fb-sketch-header">
              <span>FIELD SKETCH & MONUMENT TIES (Grid = 10 FT)</span>
              <button class="btn btn-xs btn-outline-danger" onclick="window.fieldBook.clearSketch()">Clear</button>
            </div>
            <canvas id="fb-sketch-canvas" width="460" height="190"></canvas>
          </div>

          <div class="fb-remarks-group">
            <label>Field Remarks & Monument Recoveries:</label>
            <textarea id="fb-remarks-text" rows="3">${n.remarks || ''}</textarea>
          </div>
        </div>
      </div>
    `;
  }

  // Traverse Loop Balancing & Closure Sheet
  renderTraverseSection() {
    let sumDist = 0;
    let sumLat = 0;
    let sumDep = 0;

    this.traverseData.forEach(leg => {
      sumDist += leg.dist;
      sumLat += leg.dN;
      sumDep += leg.dE;
    });

    const linearError = Math.hypot(sumLat, sumDep);
    const precisionRatio = linearError > 0 ? Math.round(sumDist / linearError) : 999999;
    const isPassing = precisionRatio >= 10000;

    return `
      <div class="traverse-container">
        <div class="traverse-header-card">
          <div class="traverse-title-row">
            <h4>Control Traverse Loop Closure & Bowditch Adjustment (CP1 - CP4)</h4>
            <span class="badge ${isPassing ? 'badge-success' : 'badge-danger'}">
              ${isPassing ? '✅ CLASS A BOUNDARY PASSED' : '⚠️ MISCLOSURE HIGH'}
            </span>
          </div>
          <div class="traverse-stats-grid">
            <div class="t-stat"><span>Perimeter:</span><b>${sumDist.toFixed(2)} ft</b></div>
            <div class="t-stat"><span>Misclosure North (ΔN):</span><b>${sumLat > 0 ? '+' : ''}${sumLat.toFixed(3)} ft</b></div>
            <div class="t-stat"><span>Misclosure East (ΔE):</span><b>${sumDep > 0 ? '+' : ''}${sumDep.toFixed(3)} ft</b></div>
            <div class="t-stat"><span>Linear Misclosure:</span><b class="text-accent">${linearError.toFixed(3)} ft</b></div>
            <div class="t-stat"><span>Precision Ratio:</span><b class="text-success">1 : ${precisionRatio.toLocaleString()}</b></div>
            <div class="t-stat"><span>Specification:</span><b>Class A (1:10,000)</b></div>
          </div>
        </div>

        <div class="table-card">
          <table class="survey-table">
            <thead>
              <tr>
                <th>TRAVERSE LEG</th>
                <th>HORIZ DIST</th>
                <th>QUADRANT BEARING</th>
                <th>LATITUDE (ΔN)</th>
                <th>DEPARTURE (ΔE)</th>
                <th>BALANCED N</th>
                <th>BALANCED E</th>
              </tr>
            </thead>
            <tbody>
              ${this.traverseData.map(leg => {
                const corrN = -(sumLat * (leg.dist / sumDist));
                const corrE = -(sumDep * (leg.dist / sumDist));
                const balN = leg.dN + corrN;
                const balE = leg.dE + corrE;
                return `
                  <tr>
                    <td><b>${leg.from} → ${leg.to}</b></td>
                    <td class="font-mono">${leg.dist.toFixed(2)}'</td>
                    <td class="font-mono">${leg.bearing}</td>
                    <td class="font-mono">${leg.dN.toFixed(2)}'</td>
                    <td class="font-mono">${leg.dE.toFixed(2)}'</td>
                    <td class="font-mono font-bold text-success">${balN.toFixed(2)}'</td>
                    <td class="font-mono font-bold text-success">${balE.toFixed(2)}'</td>
                  </tr>
                `;
              }).join('')}
            </tbody>
          </table>
        </div>

        <div class="traverse-actions-row">
          <button class="btn btn-sm btn-primary" onclick="window.aimChat.postSystemUpdate('Traverse Loop Adjusted: Precision 1:${precisionRatio.toLocaleString()} (Passed). Balanced coordinates stored.'); window.app.switchTab('aim');">
            💬 Post Traverse Results to AIM Chat
          </button>
        </div>
      </div>
    `;
  }

  // Boundary Corner Monuments & Recovery Table
  renderBoundarySection() {
    const monuments = this.notes.monuments || [];
    return `
      <div class="monument-notes-container" style="padding: 12px; display: flex; flex-direction: column; gap: 12px;">
        <div class="sue-notes-header">
          <div>
            <h4 class="font-bold">Lot 14 Boundary Monument Recoveries & Deed Calls</h4>
            <p class="text-xs text-muted">Comparison of found/set monuments (MAGNET Field) against 1984 record plat in Civil 3D.</p>
          </div>
          <button class="btn btn-xs btn-primary" onclick="window.fieldBook.promptAddMonument()">+ Log Monument</button>
        </div>

        <div class="table-card">
          <table class="survey-table">
            <thead>
              <tr>
                <th>CORNER / MONUMENT</th>
                <th>PHYSICAL DESCRIPTION</th>
                <th>NORTHING</th>
                <th>EASTING</th>
                <th>ELEVATION</th>
                <th>RECORD VS MEASURED</th>
                <th>STATUS</th>
              </tr>
            </thead>
            <tbody>
              ${monuments.map(m => `
                <tr>
                  <td><b>${m.corner}</b></td>
                  <td>${m.physicalDesc}</td>
                  <td class="font-mono">${Number(m.northing).toFixed(2)}</td>
                  <td class="font-mono">${Number(m.easting).toFixed(2)}</td>
                  <td class="font-mono">${Number(m.elevation).toFixed(2)}'</td>
                  <td>${m.comparison}</td>
                  <td><span class="badge ${m.status === 'Set' ? 'badge-warning' : 'badge-success'}">${m.status}</span></td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        </div>
      </div>
    `;
  }

  promptAddMonument() {
    const corner = prompt("Corner / Monument Name (e.g. Lot 14 West Witness Pin):", "Lot 14 Witness Corner");
    if (!corner) return;
    const physicalDesc = prompt("Physical Description (e.g. Set 5/8\" rebar w/ Topcon yellow cap):", "Set 5/8\" rebar w/ Topcon yellow cap RPLS 5421") || "Monument";
    const northing = parseFloat(prompt("Northing (Y):", "10250.00")) || 10250.00;
    const easting = parseFloat(prompt("Easting (X):", "10050.00")) || 10050.00;
    const elevation = parseFloat(prompt("Elevation (Z):", "688.00")) || 688.00;
    const comparison = prompt("Record vs Measured Note:", "Online w/ West Property Line") || "Verified";
    const status = prompt("Status (Recovered or Set):", "Set") || "Set";

    if (!this.notes.monuments) this.notes.monuments = [];
    this.notes.monuments.push({ corner, physicalDesc, northing, easting, elevation, comparison, status });
    this.save();
    this.renderFieldBook();
    if (window.soundFX) window.soundFX.playShotBeep();
    if (window.aimChat) {
      window.aimChat.postSystemUpdate(`📍 Monument Logged: ${corner} (${physicalDesc}) @ N:${northing.toFixed(2)} E:${easting.toFixed(2)}`);
    }
  }

  // Stakeout Navigator
  renderStakeoutSection() {
    const points = window.pointManager ? window.pointManager.getAll() : [];
    const stakeInfo = window.pointManager ? window.pointManager.getStakeoutDelta(this.activeStakeoutPtId) : null;

    return `
      <div class="stakeout-container">
        <div class="stakeout-control-bar">
          <label>Target Point to Stake:</label>
          <select class="form-select-sm" onchange="window.fieldBook.activeStakeoutPtId = Number(this.value); window.fieldBook.renderFieldBook();">
            ${points.map(p => `
              <option value="${p.id}" ${p.id === this.activeStakeoutPtId ? 'selected' : ''}>
                PT #${p.id} [${p.code}] - N:${p.northing.toFixed(1)} E:${p.easting.toFixed(1)} (${p.desc || 'Point'})
              </option>
            `).join('')}
          </select>
          <button class="btn btn-xs btn-outline-info" onclick="window.cadEngine.zoomToPoint(${this.activeStakeoutPtId}); window.app.switchTab('cad');">
            🔍 View on Linework Canvas
          </button>
        </div>

        ${stakeInfo ? `
          <div class="stakeout-display-grid">
            <div class="stakeout-bullseye-card">
              <div class="bullseye-ring ring-3">
                <div class="bullseye-ring ring-2">
                  <div class="bullseye-ring ring-1">
                    <div class="bullseye-center"></div>
                  </div>
                </div>
              </div>
              <div class="bullseye-status ${stakeInfo.inTolerance ? 'text-success' : 'text-accent'}">
                ${stakeInfo.inTolerance ? '🎯 IN TOLERANCE (SET PIN)' : `DISTANCE: ${stakeInfo.horizDist.toFixed(2)} FT`}
              </div>
            </div>

            <div class="stakeout-readout-card">
              <div class="stake-instruction-item highlight">
                <span>North / South:</span>
                <b>${stakeInfo.dirN}</b>
              </div>
              <div class="stake-instruction-item highlight">
                <span>East / West:</span>
                <b>${stakeInfo.dirE}</b>
              </div>
              <div class="stake-instruction-item grade">
                <span>Cut / Fill Elevation:</span>
                <b class="${stakeInfo.dZ > 0 ? 'text-accent' : 'text-rose'}">${stakeInfo.cutFill}</b>
              </div>
              <div class="stake-meta-row">
                <div>Target Point: <b>PT #${stakeInfo.target.id} (${stakeInfo.target.code})</b></div>
                <div>Bearing: <b>${stakeInfo.bearing}</b></div>
                <div>Target Elev: <b>${stakeInfo.target.elevation.toFixed(2)}'</b></div>
                <div>Rover Elev: <b>${stakeInfo.curZ.toFixed(2)}'</b></div>
              </div>
              <button class="btn btn-sm btn-success w-full mt-3" onclick="window.fieldBook.recordAsStaked(${stakeInfo.target.id})">
                ✅ Record As Staked & Store Shot
              </button>
            </div>
          </div>
        ` : `
          <p class="text-center text-muted mt-4">Select a valid survey point to begin stakeout guidance.</p>
        `}
      </div>
    `;
  }

  recordAsStaked(pointId) {
    const pt = window.pointManager.getById(pointId);
    if (!pt) return;
    window.pointManager.takeRtkShot(`STK-${pt.code}`, `Staked point #${pt.id}`);
    window.soundFX.playShotBeep();
    alert(`Point #${pt.id} recorded as staked! As-staked shot stored in database.`);
    this.renderFieldBook();
  }

  // Field Photos & Voice Notes
  renderMediaSection() {
    return `
      <div class="media-container">
        <div class="media-header-row">
          <h4>Field Photos & Voice Field Notes</h4>
          <div class="media-actions">
            <button class="btn btn-xs btn-primary" onclick="window.fieldBook.promptAddPhoto()">+ Add Photo</button>
            <button class="btn btn-xs btn-outline-warning" onclick="window.fieldBook.promptAddVoiceMemo()">🎙️ Record Voice Memo</button>
          </div>
        </div>

        <div class="media-split-grid">
          <div class="media-column">
            <h5>📷 Monument Recovery Photos (${this.photos.length})</h5>
            <div class="photo-cards-list">
              ${this.photos.map(p => `
                <div class="photo-card">
                  <div class="photo-placeholder">
                    <span class="photo-watermark">STAMP: ${p.time} | AZ: ${p.bearing}</span>
                    <span class="photo-icon">📸</span>
                  </div>
                  <div class="photo-meta">
                    <b>${p.title}</b>
                    <p class="text-xs text-muted">${p.notes}</p>
                    <span class="badge badge-primary">Linked to PT #${p.pointId}</span>
                  </div>
                </div>
              `).join('')}
            </div>
          </div>

          <div class="media-column">
            <h5>🎙️ Field Audio Memos (${this.voiceMemos.length})</h5>
            <div class="voice-cards-list">
              ${this.voiceMemos.map(v => `
                <div class="voice-card">
                  <div class="voice-play-row">
                    <button class="btn-play" onclick="window.soundFX.playShotBeep(); alert('Playing audio memo: ' + '${v.title}');">▶</button>
                    <div>
                      <b>${v.title}</b>
                      <span class="text-xs text-muted">${v.time} (${v.duration})</span>
                    </div>
                  </div>
                  <div class="voice-transcript">
                    "${v.transcript}"
                  </div>
                </div>
              `).join('')}
            </div>
          </div>
        </div>
      </div>
    `;
  }

  promptAddPhoto() {
    const title = prompt("Enter Monument Photo Description:", "SW Corner 1/2\" Iron Rod");
    if (!title) return;
    const ptId = prompt("Linked Survey Point ID:", "10");
    const notes = prompt("Field ties / witness marks:", "2.1 ft east of water meter box");

    this.photos.push({
      id: "photo-" + Date.now(),
      title,
      pointId: Number(ptId) || 1,
      bearing: "N 45° E",
      time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
      notes: notes || "Monument photo"
    });

    this.save();
    this.renderFieldBook();
    window.soundFX.playShotBeep();
  }

  promptAddVoiceMemo() {
    const title = prompt("Voice Memo Title:", "Traverse Sightline Note");
    if (!title) return;
    const transcript = prompt("Audio Note Transcript:", "Line cleared between CP1 and CP2 through heavy brush.");

    this.voiceMemos.push({
      id: "voice-" + Date.now(),
      title,
      duration: "0:15",
      time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
      transcript: transcript || ""
    });

    this.save();
    this.renderFieldBook();
    window.soundFX.playShotBeep();
  }

  initSketchCanvas() {
    this.sketchCanvas = document.getElementById('fb-sketch-canvas');
    if (!this.sketchCanvas) return;
    this.sketchCtx = this.sketchCanvas.getContext('2d');
    this.drawSketchGrid();

    let isDrawing = false, lastX = 0, lastY = 0;
    const start = (x, y) => { isDrawing = true; lastX = x; lastY = y; };
    const draw = (x, y) => {
      if (!isDrawing) return;
      this.sketchCtx.strokeStyle = "#1e293b";
      this.sketchCtx.lineWidth = 1.8;
      this.sketchCtx.beginPath();
      this.sketchCtx.moveTo(lastX, lastY);
      this.sketchCtx.lineTo(x, y);
      this.sketchCtx.stroke();
      lastX = x; lastY = y;
    };
    const stop = () => { isDrawing = false; };

    this.sketchCanvas.addEventListener('mousedown', e => {
      const r = this.sketchCanvas.getBoundingClientRect();
      start(e.clientX - r.left, e.clientY - r.top);
    });
    this.sketchCanvas.addEventListener('mousemove', e => {
      const r = this.sketchCanvas.getBoundingClientRect();
      draw(e.clientX - r.left, e.clientY - r.top);
    });
    window.addEventListener('mouseup', stop);

    this.sketchCanvas.addEventListener('touchstart', e => {
      e.preventDefault();
      const r = this.sketchCanvas.getBoundingClientRect();
      start(e.touches[0].clientX - r.left, e.touches[0].clientY - r.top);
    }, { passive: false });
    this.sketchCanvas.addEventListener('touchmove', e => {
      e.preventDefault();
      const r = this.sketchCanvas.getBoundingClientRect();
      draw(e.touches[0].clientX - r.left, e.touches[0].clientY - r.top);
    }, { passive: false });
    this.sketchCanvas.addEventListener('touchend', stop);
  }

  drawSketchGrid() {
    if (!this.sketchCtx) return;
    const ctx = this.sketchCtx;
    ctx.fillStyle = "#fffef0";
    ctx.fillRect(0, 0, this.sketchCanvas.width, this.sketchCanvas.height);
    ctx.strokeStyle = "rgba(79, 140, 201, 0.25)";
    ctx.lineWidth = 0.8;
    for (let x = 0; x < this.sketchCanvas.width; x += 20) {
      ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, this.sketchCanvas.height); ctx.stroke();
    }
    for (let y = 0; y < this.sketchCanvas.height; y += 20) {
      ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(this.sketchCanvas.width, y); ctx.stroke();
    }
  }

  clearSketch() {
    this.drawSketchGrid();
  }

  updateRow(index, field, val) {
    if (!this.notes.levelLoop[index]) return;
    if (field === 'bs' || field === 'fs') {
      this.notes.levelLoop[index][field] = val === '' ? null : parseFloat(val);
    } else {
      this.notes.levelLoop[index][field] = val;
    }
  }

  addRow() {
    if (!this.notes.levelLoop) this.notes.levelLoop = [];
    this.notes.levelLoop.push({
      station: `TP-${this.notes.levelLoop.length}`,
      bs: null,
      hi: null,
      fs: null,
      elev: null,
      remarks: "Field Turning Point"
    });
    this.renderFieldBook();
  }

  deleteRow(index) {
    if (!this.notes.levelLoop) return;
    this.notes.levelLoop.splice(index, 1);
    this.renderFieldBook();
  }

  computeLevelLoopStatsOnly() {
    if (!this.notes.levelLoop || this.notes.levelLoop.length === 0) return;

    let currentElev = 685.500;
    let currentHI = null;
    let sumBS = 0, sumFS = 0;

    for (let i = 0; i < this.notes.levelLoop.length; i++) {
      const row = this.notes.levelLoop[i];
      if (i === 0 && row.elev) currentElev = row.elev;

      if (row.fs !== null && row.fs !== undefined && currentHI !== null) {
        currentElev = currentHI - row.fs;
        row.elev = currentElev;
        sumFS += row.fs;
      }
      if (row.bs !== null && row.bs !== undefined) {
        currentHI = currentElev + row.bs;
        row.hi = currentHI;
        sumBS += row.bs;
      } else {
        row.hi = null;
      }
    }

    const startElev = this.notes.levelLoop[0].elev || 685.500;
    const endElev = this.notes.levelLoop[this.notes.levelLoop.length - 1].elev || currentElev;
    const elevDiff = endElev - startElev;
    const bsFsDiff = sumBS - sumFS;

    this.lastLoopStats = {
      sumBS, sumFS, startElev, endElev, bsFsDiff, elevDiff,
      pageCheckPassed: Math.abs(bsFsDiff - elevDiff) < 0.001,
      misclosure: endElev - startElev
    };
  }

  calculateLevelLoop() {
    this.computeLevelLoopStatsOnly();
    this.save();
    this.renderFieldBook();
    if (window.soundFX) window.soundFX.playShotBeep();
  }

  getLevelLoopSummaryHTML() {
    if (!this.lastLoopStats) {
      return `<div class="closure-summary"><span>Page Check: <b>Pending calculation (Σ BS - Σ FS = End Elev - Start Elev)</b></span></div>`;
    }
    const s = this.lastLoopStats;
    return `
      <div class="closure-summary">
        <div>Σ BS: <b>+${s.sumBS.toFixed(3)}</b> | Σ FS: <b>-${s.sumFS.toFixed(3)}</b></div>
        <div>Page Check: ${s.pageCheckPassed ? '✅ <span class="text-success font-bold">PASSED</span>' : '❌ <span class="text-danger">MATH ERROR</span>'} (Loop Misclosure: ${s.misclosure.toFixed(3)} ft - Allowable: ±0.024 ft)</div>
      </div>
    `;
  }

  saveNotesFromForm() {
    if (!this.notes) return;
    this.notes.date = document.getElementById('fb-date')?.value || this.notes.date;
    this.notes.remarks = document.getElementById('fb-remarks-text')?.value ?? this.notes.remarks;
    if (!this.notes.crew) this.notes.crew = {};
    this.notes.crew.partyChief = document.getElementById('fb-party-chief')?.value ?? this.notes.crew.partyChief;
    this.notes.crew.instrument = document.getElementById('fb-instrument-op')?.value ?? this.notes.crew.instrument;
    this.notes.crew.rodperson = document.getElementById('fb-rodperson')?.value ?? this.notes.crew.rodperson;
    this.notes.crew.notesBy = document.getElementById('fb-notes-by')?.value ?? this.notes.crew.notesBy;

    const weatherVal = document.getElementById('fb-weather')?.value;
    if (weatherVal !== undefined) {
      if (!this.notes.weather) this.notes.weather = {};
      const parts = weatherVal.split(',');
      this.notes.weather.temp = (parts[0] || '').trim();
      this.notes.weather.conditions = parts.slice(1).join(',').trim() || this.notes.weather.conditions;
    }
    const pressureVal = document.getElementById('fb-pressure')?.value;
    if (pressureVal !== undefined) {
      if (!this.notes.weather) this.notes.weather = {};
      this.notes.weather.pressure = pressureVal.trim();
    }
    const instrVal = document.getElementById('fb-instr-check')?.value;
    if (instrVal !== undefined) {
      if (!this.notes.instrumentCheck) this.notes.instrumentCheck = {};
      const parts = instrVal.split(' - ');
      this.notes.instrumentCheck.model = (parts[0] || '').trim();
      if (parts[1]) this.notes.instrumentCheck.collimationCheck = parts.slice(1).join(' - ').trim();
    }

    this.save();
    if (window.soundFX) window.soundFX.playShotBeep();
    if (window.app && window.app.showToast) {
      window.app.showToast("Survey Field Notes saved!");
    } else {
      alert("Survey Field Notes Saved Successfully!");
    }
  }
}

window.FieldBook = FieldBook;
window.fieldBook = new FieldBook();

// --- js/jobs.js ---
// Job Management and Survey Checklist Engine (Done & What's Left To Do)
class JobManager {
  constructor() {
    this.jobs = [];
    this.currentJobId = "JOB-2026-104";
    this.currentCategoryFilter = "all";
    this.currentStatusFilter = "all"; // 'all', 'done', 'todo'
    this.listeners = [];
  }

  init(initialJobs) {
    const saved = localStorage.getItem('survey_jobs');
    if (saved) {
      try {
        this.jobs = JSON.parse(saved);
      } catch (e) {
        this.jobs = initialJobs ? [...initialJobs] : [];
      }
    } else {
      this.jobs = initialJobs ? [...initialJobs] : [];
    }

    // Migrate legacy jobs that lack Topcon/Sokkia/MAGNET/Civil3D hardware specs
    if (initialJobs && this.jobs.length > 0) {
      this.jobs = this.jobs.map(job => {
        if (!job.hardware) {
          const match = initialJobs.find(ij => ij.id === job.id || ij.number === job.number);
          return {
            ...job,
            hardware: match?.hardware || {
              tablet: "Topcon FC-6000 Rugged Field Tablet",
              software: "MAGNET Field v8.2",
              gpsRover: "Topcon HiPer VR GNSS (TopNET Live VRS)",
              totalStation: "Sokkia iX-1200 Robotic Total Station",
              cadOffice: "Autodesk Civil 3D 2026"
            }
          };
        }
        return job;
      });
    }

    const savedJobId = localStorage.getItem('survey_current_job_id');
    if (savedJobId && this.jobs.some(j => j.id === savedJobId)) {
      this.currentJobId = savedJobId;
    } else if (this.jobs.length > 0) {
      this.currentJobId = this.jobs[0].id;
    }

    this.render();
  }

  save() {
    localStorage.setItem('survey_jobs', JSON.stringify(this.jobs));
    localStorage.setItem('survey_current_job_id', this.currentJobId);
    this.notify();
  }

  subscribe(cb) {
    this.listeners.push(cb);
  }

  notify() {
    this.listeners.forEach(cb => {
      try { cb(this.getCurrentJob()); } catch (e) { console.error(e); }
    });
  }

  getCurrentJob() {
    return this.jobs.find(j => j.id === this.currentJobId) || this.jobs[0];
  }

  setCurrentJob(jobId) {
    this.currentJobId = jobId;
    this.save();
    this.render();
    if (window.app && window.app.syncActiveJobHeader) window.app.syncActiveJobHeader();
    if (window.soundFX) window.soundFX.playShotBeep();
  }

  // Toggle checklist task status
  toggleTask(taskId) {
    const job = this.getCurrentJob();
    if (!job || !job.checklist) return;

    const task = job.checklist.find(t => t.id === taskId);
    if (task) {
      task.done = !task.done;
      this.updateProgress(job);
      this.save();
      this.render();

      window.soundFX.playShotBeep();

      // Post checklist update to AIM chat
      if (window.aimChat) {
        window.aimChat.postSystemUpdate(
          `📋 Checklist Updated: [${task.title}] marked as ${task.done ? 'COMPLETED ✅' : 'PENDING ⏳'} by ${task.assignedTo}`
        );
      }
    }
  }

  updateProgress(job) {
    if (!job.checklist || job.checklist.length === 0) {
      job.progress = 0;
      return;
    }
    const doneCount = job.checklist.filter(t => t.done).length;
    job.progress = Math.round((doneCount / job.checklist.length) * 100);
  }

  addTask(title, category, assignedTo, notes = "") {
    const job = this.getCurrentJob();
    if (!job) return;

    const newTask = {
      id: "task-" + Date.now(),
      category: category || "Field Operations",
      title: title.trim(),
      done: false,
      assignedTo: assignedTo || "Field Crew",
      notes: notes.trim()
    };

    job.checklist.push(newTask);
    this.updateProgress(job);
    this.save();
    this.render();
    window.soundFX.playShotBeep();
  }

  deleteTask(taskId) {
    const job = this.getCurrentJob();
    if (!job || !job.checklist) return;

    job.checklist = job.checklist.filter(t => t.id !== taskId);
    this.updateProgress(job);
    this.save();
    this.render();
  }

  createJob(jobData) {
    const equip = (window.app && window.app.equipmentProfile) ? window.app.equipmentProfile : null;
    const newJob = {
      id: "JOB-" + Date.now(),
      number: jobData.number || "2026-" + Math.floor(100 + Math.random() * 900),
      name: jobData.name || "New Survey Project",
      client: jobData.client || "Client Name",
      location: jobData.location || "County / State",
      datum: jobData.datum || "NAD83 / NAVD88",
      dateCreated: new Date().toISOString().split('T')[0],
      status: "In Progress",
      partyChief: jobData.partyChief || "Field Crew Chief",
      cadOperator: jobData.cadOperator || "Civil 3D Office Drafter",
      hardware: jobData.hardware || {
        tablet: equip ? equip.tablet : "Topcon FC-6000 Rugged Field Tablet",
        software: equip ? equip.software : "MAGNET Field v8.2",
        gpsRover: equip ? `${equip.gps} (${equip.network})` : "Topcon HiPer VR GNSS",
        totalStation: equip ? equip.totalStation : "Sokkia iX-1200 Robotic",
        cadOffice: equip ? equip.cadOffice : "Autodesk Civil 3D 2026"
      },
      weather: "70°F, Clear",
      progress: 0,
      checklist: [
        { id: "c1", category: "Pre-Field", title: "Create Civil 3D Survey DB & Coordinate System", done: false, assignedTo: "Civil 3D Office", notes: "" },
        { id: "c2", category: "Pre-Field", title: "Export control points to MAGNET Field (.csv / .rw5)", done: false, assignedTo: "Civil 3D Office", notes: "" },
        { id: "c3", category: "Field Operations", title: "Recover existing boundary iron pins & control", done: false, assignedTo: "Field Crew", notes: "" },
        { id: "c4", category: "Field Operations", title: "Collect MAGNET Field coded topo & breaklines", done: false, assignedTo: "Field Crew", notes: "" },
        { id: "c5", category: "Field Operations", title: "Utility invert and rim elevation dips", done: false, assignedTo: "Field Crew", notes: "" },
        { id: "c6", category: "Office CAD", title: "Import MAGNET .RW5 / .FBK & balance traverse", done: false, assignedTo: "Civil 3D Office", notes: "" },
        { id: "c7", category: "Office CAD", title: "Civil 3D Field-to-Finish figure generation", done: false, assignedTo: "Civil 3D Office", notes: "" },
        { id: "c8", category: "Deliverables & QA", title: "RPLS Review, Seal & Civil 3D DWG/DXF Delivery", done: false, assignedTo: "Civil 3D Office", notes: "" }
      ]
    };

    this.jobs.push(newJob);
    this.currentJobId = newJob.id;
    this.save();
    this.render();
    if (window.app && window.app.syncActiveJobHeader) window.app.syncActiveJobHeader();
    if (window.soundFX) window.soundFX.playDoorOpen();
  }

  setFilter(category, status) {
    if (category !== undefined) this.currentCategoryFilter = category;
    if (status !== undefined) this.currentStatusFilter = status;
    this.render();
  }

  render() {
    const job = this.getCurrentJob();
    const container = document.getElementById('jobs-container');
    if (!container || !job) return;

    this.updateProgress(job);

    const checklist = job.checklist || [];
    const totalTasks = checklist.length;
    const doneTasks = checklist.filter(t => t.done).length;
    const pendingTasks = totalTasks - doneTasks;

    // Filter checklist
    let filteredTasks = checklist;
    if (this.currentCategoryFilter !== "all") {
      filteredTasks = filteredTasks.filter(t => t.category === this.currentCategoryFilter);
    }
    if (this.currentStatusFilter === "done") {
      filteredTasks = filteredTasks.filter(t => t.done);
    } else if (this.currentStatusFilter === "todo") {
      filteredTasks = filteredTasks.filter(t => !t.done);
    }

    container.innerHTML = `
      <div class="jobs-layout">
        <!-- Job Overview Card -->
        <div class="job-card-hero">
          <div class="job-hero-header">
            <div class="job-hero-meta">
              <span class="badge badge-primary">JOB #${job.number}</span>
              <span class="badge ${job.status === 'In Progress' ? 'badge-warning' : 'badge-success'}">${job.status}</span>
              <span class="job-datum-tag">${job.datum}</span>
            </div>
            <div class="job-switcher-dropdown">
              <select onchange="window.jobManager.setCurrentJob(this.value)" class="form-select-sm">
                ${this.jobs.map(j => `<option value="${j.id}" ${j.id === job.id ? 'selected' : ''}>${j.number} - ${j.name}</option>`).join('')}
              </select>
              <button class="btn btn-sm btn-outline-primary" onclick="window.jobManager.showNewJobModal()">+ New Job</button>
            </div>
          </div>

          <h2 class="job-title">${job.name}</h2>
          <div class="job-details-row">
            <div><i class="icon">👤</i> Client: <b>${job.client}</b></div>
            <div><i class="icon">📍</i> Location: <b>${job.location}</b></div>
            <div><i class="icon">👷</i> Field Chief: <b>${job.partyChief}</b></div>
            <div><i class="icon">🖥️</i> CAD Operator: <b>${job.cadOperator}</b></div>
          </div>

          ${job.hardware ? `
            <div class="job-hardware-strip">
              <span class="hw-chip hw-topcon">📟 ${job.hardware.tablet}</span>
              <span class="hw-chip hw-magnet">🧭 ${job.hardware.software}</span>
              <span class="hw-chip hw-gnss">🛰️ ${job.hardware.gpsRover}</span>
              <span class="hw-chip hw-ts">🔭 ${job.hardware.totalStation}</span>
              <span class="hw-chip hw-c3d">🖥️ ${job.hardware.cadOffice}</span>
            </div>
          ` : ''}

          <!-- Progress Bar & Metrics -->
          <div class="job-progress-section">
            <div class="progress-labels">
              <span>Overall Job Completion: <b>${job.progress}%</b></span>
              <span><b>${doneTasks}</b> Done / <b>${pendingTasks}</b> Left To Do (${totalTasks} Total)</span>
            </div>
            <div class="progress-track">
              <div class="progress-bar ${job.progress > 80 ? 'bg-success' : 'bg-primary'}" style="width: ${job.progress}%;"></div>
            </div>
          </div>
        </div>

        <!-- Checklist Controls & Filters -->
        <div class="checklist-header-bar">
          <div class="checklist-filters">
            <button class="filter-chip ${this.currentStatusFilter === 'all' ? 'active' : ''}" onclick="window.jobManager.setFilter(undefined, 'all')">
              All Tasks (${totalTasks})
            </button>
            <button class="filter-chip ${this.currentStatusFilter === 'todo' ? 'active' : ''}" onclick="window.jobManager.setFilter(undefined, 'todo')">
              ⏳ Left To Do (${pendingTasks})
            </button>
            <button class="filter-chip ${this.currentStatusFilter === 'done' ? 'active' : ''}" onclick="window.jobManager.setFilter(undefined, 'done')">
              ✅ Completed (${doneTasks})
            </button>
          </div>

          <div class="checklist-cat-filters">
            <select class="form-select-xs" onchange="window.jobManager.setFilter(this.value, undefined)">
              <option value="all" ${this.currentCategoryFilter === 'all' ? 'selected' : ''}>All Categories</option>
              <option value="Pre-Field" ${this.currentCategoryFilter === 'Pre-Field' ? 'selected' : ''}>Pre-Field & Research</option>
              <option value="Field Operations" ${this.currentCategoryFilter === 'Field Operations' ? 'selected' : ''}>Field Operations</option>
              <option value="Office CAD" ${this.currentCategoryFilter === 'Office CAD' ? 'selected' : ''}>Office CAD Drafting</option>
              <option value="Deliverables & QA" ${this.currentCategoryFilter === 'Deliverables & QA' ? 'selected' : ''}>Deliverables & QA</option>
            </select>
            <button class="btn btn-xs btn-primary" onclick="window.jobManager.showAddTaskModal()">+ Add Checklist Item</button>
          </div>
        </div>

        <!-- Checklist Items List -->
        <div class="checklist-list">
          ${filteredTasks.length === 0 ? `
            <div class="checklist-empty">
              <span>No checklist tasks match the active filters.</span>
            </div>
          ` : filteredTasks.map(task => `
            <div class="checklist-item ${task.done ? 'is-done' : 'is-pending'}">
              <div class="check-toggle" onclick="window.jobManager.toggleTask('${task.id}')">
                <input type="checkbox" ${task.done ? 'checked' : ''} readonly>
              </div>

              <div class="check-content">
                <div class="check-main-row">
                  <span class="check-title ${task.done ? 'line-through' : ''}">${task.title}</span>
                  <div class="check-badges">
                    <span class="cat-badge cat-${task.category.toLowerCase().replace(/[^a-z]/g, '')}">${task.category}</span>
                    ${(() => {
                      const isCad = /cad|civil/i.test(task.assignedTo || '');
                      return `<span class="assignee-badge ${isCad ? 'badge-cad' : 'badge-field'}">${isCad ? '🖥️ Civil 3D' : '👷 Field'}</span>`;
                    })()}
                  </div>
                </div>

                ${task.notes ? `
                  <div class="check-notes">
                    <span class="notes-icon">📝</span> ${task.notes}
                  </div>
                ` : ''}
              </div>

              <div class="check-actions">
                <button class="btn-icon text-muted" title="Delete task" onclick="window.jobManager.deleteTask('${task.id}')">🗑️</button>
              </div>
            </div>
          `).join('')}
        </div>
      </div>
    `;
  }

  showAddTaskModal() {
    const title = prompt("Enter New Checklist Task Title (e.g. Locate SW lot corner pin):");
    if (!title) return;

    const category = prompt("Category (Pre-Field, Field Operations, Office CAD, Deliverables & QA):", "Field Operations") || "Field Operations";
    const assignedTo = prompt("Assign To (Field Crew or CAD Office):", "Field Crew") || "Field Crew";
    const notes = prompt("Notes or specifics:", "") || "";

    this.addTask(title, category, assignedTo, notes);
  }

  showNewJobModal() {
    const name = prompt("Enter Project Name:", "Highway 71 Boundary Survey");
    if (!name) return;

    const client = prompt("Client Name:", "Texas Department of Transportation");
    const location = prompt("Location:", "Travis County, TX");
    const number = "2026-" + Math.floor(100 + Math.random() * 900);

    this.createJob({ name, client, location, number });
  }
}

window.JobManager = JobManager;
window.jobManager = new JobManager();

// --- js/aim-chat.js ---
// Authentic AOL Instant Messenger (AIM) Live Chat Engine - 2-Person Direct IM Edition
// Links Civil 3D Office CAD Operators and Topcon/Sokkia MAGNET Field Crew in Real-Time
// Strictly restricted to a 1-on-1 direct conversation between two people at a time.
class AimChat {
  constructor() {
    this.currentUser = {
      screenName: "TopconCrew_Mike",
      alias: "Mike (Party Chief - Topcon FC-6000)",
      role: "field",
      status: "online",
      statusMsg: "MAGNET Field v8.2 Running on Topcon FC-6000 • HiPer VR Fixed",
      warningLevel: 0
    };

    this.buddies = [];
    this.messages = [];
    this.activeBuddy = "Civil3D_Dave";
    this.broadcastChannel = null;

    // Formatting state
    this.isBold = false;
    this.isItalic = false;
    this.isUnderline = false;
    this.textColor = "#000000";
    this.fontSize = "normal";

    this.initBroadcast();
  }

  _migrateName(name) {
    if (name === "AutoCAD_Dave") return "Civil3D_Dave";
    if (name === "FieldCrew1_Mike") return "TopconCrew_Mike";
    if (name === "SurveyBot") return "MagnetBot";
    return name;
  }

  init(initialData) {
    const savedBuddies = localStorage.getItem('survey_aim_buddies');
    const savedMessages = localStorage.getItem('survey_aim_messages');
    const savedUser = localStorage.getItem('survey_aim_current_user');

    if (savedBuddies) {
      try {
        this.buddies = JSON.parse(savedBuddies);
      } catch (e) {
        this.buddies = initialData.buddies ? [...initialData.buddies] : [];
      }
    } else {
      this.buddies = initialData.buddies ? [...initialData.buddies] : [];
    }

    // Ensure contacts exist
    if (initialData && initialData.buddies) {
      initialData.buddies.forEach(initB => {
        if (!this.buddies.some(b => b.screenName === initB.screenName)) {
          this.buddies.push({ ...initB });
        }
      });
    }

    if (savedMessages) {
      try {
        this.messages = JSON.parse(savedMessages).map(m => ({
          ...m,
          from: this._migrateName(m.from),
          to: this._migrateName(m.to)
        }));
      } catch (e) {
        this.messages = initialData.messages ? [...initialData.messages] : [];
      }
    } else {
      this.messages = initialData.messages ? [...initialData.messages] : [];
    }

    if (savedUser) {
      try {
        const parsedUser = JSON.parse(savedUser);
        parsedUser.screenName = this._migrateName(parsedUser.screenName);
        if (parsedUser.screenName === "TopconCrew_Mike" && parsedUser.alias.includes("Rover 1")) {
          parsedUser.alias = "Mike (Party Chief - Topcon FC-6000)";
        } else if (parsedUser.screenName === "Civil3D_Dave" && parsedUser.alias.includes("Senior CAD Drafter")) {
          parsedUser.alias = "Dave (Senior Civil 3D Drafter)";
        }
        this.currentUser = parsedUser;
      } catch (e) {
        if (initialData && initialData.currentUser) this.currentUser = { ...initialData.currentUser };
      }
    } else if (initialData && initialData.currentUser) {
      this.currentUser = { ...initialData.currentUser };
    }

    // Set 2-person partner based on role
    this.activeBuddy = this.currentUser.role === 'cad' ? "TopconCrew_Mike" : "Civil3D_Dave";
    this.save();
    this.renderAim();

    window.addEventListener('storage', (e) => {
      if (e.key === 'survey_aim_last_msg' && e.newValue) {
        try {
          const msg = JSON.parse(e.newValue);
          this.handleIncomingExternalMessage(msg);
        } catch (err) {}
      }
    });
  }

  initBroadcast() {
    if (window.BroadcastChannel) {
      this.broadcastChannel = new window.BroadcastChannel('survey_aim_channel');
      this.broadcastChannel.onmessage = (ev) => {
        if (ev.data && ev.data.type === 'CHAT_MESSAGE') {
          this.handleIncomingExternalMessage(ev.data.payload);
        }
      };
    }
  }

  handleIncomingExternalMessage(msg) {
    if (!msg || msg.from === this.currentUser.screenName) return;
    this.messages.push(msg);
    localStorage.setItem('survey_aim_messages', JSON.stringify(this.messages));

    // Only chime and update if this message is between the two active people
    if (msg.from === this.activeBuddy && msg.to === this.currentUser.screenName) {
      if (window.soundFX) window.soundFX.playImChime();
      this.renderConversation();
    }
  }

  save() {
    localStorage.setItem('survey_aim_buddies', JSON.stringify(this.buddies));
    localStorage.setItem('survey_aim_messages', JSON.stringify(this.messages));
    localStorage.setItem('survey_aim_current_user', JSON.stringify(this.currentUser));
  }

  // Switch identity between Topcon/Sokkia Field Crew and Civil 3D CAD Operator
  switchUserRole(role) {
    const equip = (window.app && window.app.equipmentProfile) ? window.app.equipmentProfile : null;
    const tabletLabel = equip ? equip.tablet : "Topcon FC-6000";
    const gpsLabel = equip ? equip.gps : "Topcon HiPer VR";

    if (role === 'field') {
      this.currentUser = {
        screenName: "TopconCrew_Mike",
        alias: `Mike (Party Chief - ${tabletLabel})`,
        role: "field",
        status: "online",
        statusMsg: `MAGNET Field v8.2 on ${tabletLabel} • ${gpsLabel} Fixed`,
        warningLevel: 0
      };
      this.activeBuddy = "Civil3D_Dave";
    } else {
      this.currentUser = {
        screenName: "Civil3D_Dave",
        alias: "Dave (Senior Civil 3D Drafter)",
        role: "cad",
        status: "online",
        statusMsg: "Civil 3D 2026 Survey Database Open — Send MAGNET .RW5!",
        warningLevel: 0
      };
      this.activeBuddy = "TopconCrew_Mike";
    }

    this.save();
    if (window.soundFX) window.soundFX.playDoorOpen();
    this.renderAim();
  }

  // Quick swap between Field Chief (Mike) and Civil 3D Drafter (Dave)
  toggleUserRole() {
    if (this.currentUser.role === 'field') {
      this.switchUserRole('cad');
    } else {
      this.switchUserRole('field');
    }
  }

  // Set the 2nd person in the 2-person session
  setActiveBuddy(screenName) {
    if (screenName === this.currentUser.screenName) return;
    this.activeBuddy = screenName;
    const buddy = this.buddies.find(b => b.screenName === screenName);
    if (buddy) buddy.unread = 0;
    this.save();
    this.renderAim();
  }

  _getResolvedActiveBuddy() {
    const eligible = this.getEligiblePartners();
    let b = eligible.find(p => p.screenName === this.activeBuddy);
    if (!b) b = eligible[0] || this.buddies[0];
    return b;
  }

  // Return persons eligible to be the 2nd party (human survey staff only)
  getEligiblePartners() {
    return this.buddies.filter(b =>
      b.screenName !== this.currentUser.screenName &&
      b.role !== 'bot'
    );
  }

  updateBuddyBadge(screenName) {
    if (this.activeBuddy !== screenName) {
      const b = this.buddies.find(buddy => buddy.screenName === screenName);
      if (b) b.unread = (b.unread || 0) + 1;
      this.save();
    }
  }

  // Send message strictly from Person 1 (currentUser) to Person 2 (activeBuddy)
  sendMessage(text, customHtml = null) {
    if (!text && !customHtml) return;

    let formattedText = text;
    if (!customHtml) {
      if (this.isBold) formattedText = `<b>${formattedText}</b>`;
      if (this.isItalic) formattedText = `<i>${formattedText}</i>`;
      if (this.isUnderline) formattedText = `<u>${formattedText}</u>`;
      if (this.textColor !== "#000000") {
        formattedText = `<span style="color: ${this.textColor}">${formattedText}</span>`;
      }
    } else {
      formattedText = customHtml;
    }

    const newMsg = {
      id: "msg-" + Date.now(),
      from: this.currentUser.screenName,
      to: this.activeBuddy,
      time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
      text: formattedText
    };

    this.messages.push(newMsg);
    this.save();

    if (this.broadcastChannel) {
      this.broadcastChannel.postMessage({ type: 'CHAT_MESSAGE', payload: newMsg });
    }
    localStorage.setItem('survey_aim_last_msg', JSON.stringify(newMsg));

    if (window.soundFX) window.soundFX.playImSend();
    this.renderConversation();

    this.checkAutoReply(text);
  }

  promptSetAway() {
    const msg = prompt("Enter your Custom Away Message:", this.currentUser.statusMsg || "Away: Running Topcon HiPer VR static check");
    if (msg !== null) {
      this.currentUser.statusMsg = msg.trim() || "Away";
      this.currentUser.status = "away";
      this.save();
      this.renderAim();
      if (window.soundFX) window.soundFX.playDoorOpen();
    }
  }

  showTypingIndicator(screenName) {
    const log = document.getElementById('aim-message-log');
    if (!log) return;

    let el = document.getElementById('aim-typing-indicator');
    if (!el) {
      el = document.createElement('div');
      el.id = 'aim-typing-indicator';
      el.className = 'aim-typing-row';
      log.appendChild(el);
    }
    el.innerHTML = `<i>⌨️ ${screenName.split('_')[0]} is typing...</i>`;
    log.scrollTop = log.scrollHeight;

    if (this._typingTimeout) clearTimeout(this._typingTimeout);
    this._typingTimeout = setTimeout(() => {
      const existing = document.getElementById('aim-typing-indicator');
      if (existing) existing.remove();
    }, 2000);
  }

  // Automated realistic response strictly from Person 2 (partner) back to Person 1
  checkAutoReply(userText) {
    const buddy = this._getResolvedActiveBuddy();
    if (!buddy || buddy.screenName === this.currentUser.screenName) return;

    setTimeout(() => {
      this.showTypingIndicator(buddy.screenName);
    }, 550);

    setTimeout(() => {
      let replyText = "";
      const lower = (userText || "").toLowerCase();
      const equip = (window.app && window.app.equipmentProfile) ? window.app.equipmentProfile : {
        tablet: "Topcon FC-6000",
        gps: "Topcon HiPer VR",
        totalStation: "Sokkia iX-1200",
        network: "TopNET Live VRS"
      };

      if ((buddy.screenName === "Civil3D_Dave" || buddy.screenName === "Civil3D_Sarah") && this.currentUser.role === "field") {
        if (lower.includes("rw5") || lower.includes("fbk") || lower.includes("file") || lower.includes("export")) {
          replyText = "Got your MAGNET Field data! Importing the .FBK into Civil 3D 2026 Survey Database right now — survey figures are snapping to V-PROP-LINE and V-ROAD-CURB.";
        } else if (lower.includes("corner") || lower.includes("pin") || lower.includes("sw")) {
          replyText = "Nice recovery Mike! Point #10 dropped right onto the 1984 record plat corner in Civil 3D. Keep shooting the lot corners and fence ties.";
        } else if (lower.includes("water") || lower.includes("meter") || lower.includes("sewer")) {
          replyText = "Utility ties received! Updating V-UTIL-WATR and V-UTIL-SSWR pipes in Civil 3D Pipe Network now.";
        } else if (lower.includes("invert") || lower.includes("manhole") || lower.includes("mh")) {
          replyText = "Invert 675.30' logged in Civil 3D structure properties on SAN MH-1. Rim-to-invert fall (9.20') matches record plan.";
        } else if (lower.includes("linework") || lower.includes("dxf")) {
          replyText = "Linework overlay came through cleanly! Civil 3D Figure Prefix DB matched your MAGNET Field codes.";
        } else {
          replyText = "Copy that Mike! Updating Civil 3D Survey Database now — keep those MAGNET Field shots coming.";
        }
      } else if (buddy.screenName === "TopconCrew_Mike" && this.currentUser.role === "cad") {
        replyText = `Copy that Dave! ${equip.tablet} running MAGNET Field v8.2 with ${equip.gps} (${equip.network} Fixed) & ${equip.totalStation} ready on CP1. Moving to next shot.`;
      } else if (buddy.screenName === "Office_PM_Frank") {
        replyText = "Thanks for the update! Let me know once the Civil 3D .FBK and RPLS boundary check are ready for final sign-off.";
      } else {
        replyText = "Copy that from field! Synchronized in Civil 3D.";
      }

      if (replyText) {
        const botMsg = {
          id: "msg-" + Date.now(),
          from: buddy.screenName,
          to: this.currentUser.screenName,
          time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
          text: replyText
        };
        this.messages.push(botMsg);
        this.save();
        if (window.soundFX) window.soundFX.playImChime();
        this.renderConversation();
      }
    }, 1400);
  }

  sendPointToChat(pointId) {
    const pt = window.pointManager ? window.pointManager.getById(pointId) : null;
    if (!pt) {
      if (window.app && window.app.showToast) window.app.showToast(`Point #${pointId} not found.`);
      return;
    }

    const html = `
      <div class="chat-point-badge" onclick="window.cadEngine.zoomToPoint(${pt.id}); window.app.switchTab('cad');">
        <span class="badge-tag">📍 MAGNET POINT #${pt.id}</span>
        <b>${pt.code}</b> (${pt.desc || 'Shot'})
        <div class="badge-coords">N: ${pt.northing.toFixed(2)} | E: ${pt.easting.toFixed(2)} | Elev: ${pt.elevation.toFixed(2)}' | HR: ${(pt.hr || 5.0).toFixed(2)}'</div>
        <span class="badge-link">🔍 Click to zoom Survey Canvas</span>
      </div>
    `;

    this.sendMessage(`Sent Point #${pt.id} (${pt.code})`, html);
  }

  sendInverseToChat(bearing, horizDist, deltaZ) {
    const html = `
      <div class="chat-cogo-badge">
        <span class="badge-tag">📐 INVERSE CALCULATION (COGO)</span>
        <div>Bearing: <b class="text-accent">${bearing}</b></div>
        <div>Horiz Dist: <b>${horizDist} ft</b> | ΔZ: <b>${deltaZ} ft</b></div>
      </div>
    `;
    this.sendMessage(`Inverse: ${bearing} ${horizDist}'`, html);
  }

  sendLineworkSummary() {
    const lines = window.cadEngine ? window.cadEngine.linework : [];
    const html = `
      <div class="chat-cogo-badge">
        <span class="badge-tag">📐 MAGNET → CIVIL 3D LINEWORK</span>
        <div>Total Figures: <b>${lines.length}</b></div>
        <div>Civil 3D Layers: <b>V-PROP-LINE, V-ROAD-CNTR, V-ROAD-CURB, V-BLDG, V-UTIL-WATR</b></div>
        <span class="badge-link" onclick="window.app.switchTab('cad')">🔍 View on Linework Canvas</span>
      </div>
    `;
    this.sendMessage(`Shared Civil 3D Linework (${lines.length} figures)`, html);
  }

  sendSurveyFilePacket(format) {
    if (!window.dxfManager) return;
    if (format === 'fbk') {
      const res = window.dxfManager.generateCivil3dFbkContent();
      const html = `
        <div class="chat-cogo-badge" style="border-color:#f59e0b; background:#fffbeb;">
          <span class="badge-tag" style="color:#b45309;">📤 CIVIL 3D FIELD BOOK (.FBK)</span>
          <div><b>${res.filename}</b></div>
          <div class="badge-coords">${res.pointCount} Points • ${res.figureCount} Civil 3D Figures</div>
          <span class="badge-link" style="cursor:pointer; color:#b45309; font-weight:bold;" onclick="window.dxfManager.exportCivil3dFbk('${res.filename}')">📥 Download ${res.filename} for Civil 3D</span>
        </div>
      `;
      this.sendMessage(`Sent Civil 3D Field Book ${res.filename} (${res.pointCount} pts, ${res.figureCount} figures)`, html);
    } else {
      const res = window.dxfManager.generateMagnetRawContent();
      const html = `
        <div class="chat-point-badge" style="border-color:#0284c7; background:#f0f9ff;">
          <span class="badge-tag" style="color:#0369a1;">📤 MAGNET FIELD RAW (.RW5)</span>
          <div><b>${res.filename}</b></div>
          <div class="badge-coords">${res.pointCount} Points • Topcon/Sokkia MAGNET Field v8.2</div>
          <span class="badge-link" style="cursor:pointer; font-weight:bold;" onclick="window.dxfManager.exportMagnetRaw('${res.filename}')">📥 Download ${res.filename} for MAGNET / Civil 3D</span>
        </div>
      `;
      this.sendMessage(`Sent MAGNET Field raw file ${res.filename} (${res.pointCount} pts)`, html);
    }
  }

  requestShotFromCrew(feature) {
    const text = `⚠️ CIVIL 3D REQUEST: Please shoot ${feature || 'Boundary Pin / Utility Invert'} in MAGNET Field with rod height & description.`;
    this.sendMessage(text);
  }

  postSystemUpdate(announcement) {
    const sysMsg = {
      id: "sys-" + Date.now(),
      from: this.activeBuddy,
      to: this.currentUser.screenName,
      time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
      text: `📢 <b>${announcement}</b>`
    };
    this.messages.push(sysMsg);
    this.save();
    this.renderConversation();
  }

  postSystemMessage(announcement) {
    return this.postSystemUpdate(announcement);
  }

  warnBuddy(screenName) {
    const buddy = this.buddies.find(b => b.screenName === screenName);
    if (!buddy) return;

    buddy.warningLevel = (buddy.warningLevel || 0) + 5;
    if (window.soundFX) window.soundFX.playWarningBeep();
    this.save();
    this.renderAim();

    this.sendMessage(`[SYSTEM ALERT] User was WARNED! Warning level increased to ${buddy.warningLevel}%.`);
  }

  // Strictly 2-Person Conversation Filtering: only messages between Person A and Person B
  getConversationHTML(buddy) {
    const userA = this.currentUser.screenName;
    const userB = buddy.screenName;

    const relevant = this.messages.filter(m => {
      return (m.from === userA && m.to === userB) ||
             (m.from === userB && m.to === userA);
    });

    if (relevant.length === 0) {
      return `
        <div class="aim-conversation-empty">
          <div class="aim-2p-intro-badge">
            <span class="badge-title">🔒 Direct 2-Person Private IM</span>
            <div class="badge-users"><b>${this.currentUser.alias.split(' ')[0]}</b> ↔ <b>${buddy.alias.split(' ')[0]}</b></div>
          </div>
          <p class="text-xs text-muted" style="margin-top: 8px;">
            1-on-1 link between Topcon/Sokkia Field Chief &amp; Civil 3D Office.<br>
            Send coordinates, shot requests, or linework.
          </p>
        </div>
      `;
    }

    return relevant.map(m => {
      const isMe = m.from === this.currentUser.screenName;
      const authorShort = isMe ? this.currentUser.alias.split(' ')[0] : buddy.alias.split(' ')[0];
      return `
        <div class="aim-msg-row ${isMe ? 'msg-me' : 'msg-them'}">
          <div class="msg-meta">
            <span class="msg-author">${authorShort}:</span>
            <span class="msg-timestamp">${m.time}</span>
          </div>
          <div class="msg-bubble">
            ${m.text}
          </div>
        </div>
      `;
    }).join('');
  }

  // Render the Dedicated 2-Person Instant Message Window for the 1/4 Screen
  renderAim() {
    const container = document.getElementById('aim-container');
    if (!container) return;

    const buddy = this._getResolvedActiveBuddy();
    if (!buddy) return;

    const eligiblePartners = this.getEligiblePartners();
    const myShort = this.currentUser.alias.split(' ')[0];
    const partnerShort = buddy.alias.split(' ')[0];

    container.innerHTML = `
      <div class="aim-window-frame">
        <!-- AIM Window Title Bar -->
        <div class="aim-title-bar">
          <div class="aim-title-left">
            <span class="aim-running-man">🏃</span>
            <span class="aim-title-text">IM: ${myShort} ↔ ${partnerShort}</span>
          </div>
          <div class="aim-window-controls">
            <span class="aim-badge-2p" title="Strictly 2-Person Direct Conversation">🔒 2-Person</span>
            <button class="aim-win-btn" title="Minimize">_</button>
            <button class="aim-win-btn" title="Maximize">□</button>
          </div>
        </div>

        <!-- 2-Person Direct Session Bar (Swap role or switch partner) -->
        <div class="aim-2p-session-bar">
          <div class="aim-2p-pair">
            <div class="aim-party-pill me" title="You: ${this.currentUser.alias}">
              <span class="status-dot status-${this.currentUser.status}"></span>
              <span>You: <b>${myShort}</b></span>
              <button class="btn-swap-role" onclick="window.aimChat.toggleUserRole()" title="Swap between Field Chief & CAD Drafter">⇄</button>
            </div>
            <span class="aim-arrow" style="font-weight: bold; color: #0055ea;">↔</span>
            <div class="aim-party-pill them" title="Conversing with (1 person at a time)">
              <span class="status-dot status-${buddy.status}"></span>
              <select id="aim-partner-select" class="partner-dropdown" onchange="window.aimChat.setActiveBuddy(this.value)" title="Choose conversation partner (strictly 2 people at a time)">
                ${eligiblePartners.map(p => `
                  <option value="${p.screenName}" ${p.screenName === buddy.screenName ? 'selected' : ''}>
                    ${p.alias.split(' ')[0]} (${p.role === 'cad' ? 'CAD' : p.role === 'field' ? 'Field' : 'PM'})
                  </option>
                `).join('')}
              </select>
            </div>
          </div>
        </div>

        <!-- Quick Survey Actions (Compact) -->
        <div class="aim-survey-toolbar compact">
          <button class="btn btn-xs btn-outline-light" onclick="window.aimChat.requestShotFromCrew('SW Lot Boundary Corner')" title="Request Survey Shot">
            🎯 Req Shot
          </button>
          <button class="btn btn-xs btn-outline-light" onclick="window.aimChat.promptSendPoint()" title="Send Point Coordinates">
            📍 Send Pt
          </button>
          <button class="btn btn-xs btn-outline-light" onclick="window.aimChat.sendLineworkSummary()" title="Send Linework Summary">
            📏 Lines
          </button>
          <button class="btn btn-xs btn-outline-light" onclick="window.aimChat.sendSurveyFilePacket('rw5')" title="Send MAGNET .RW5 Raw File">
            📤 .RW5
          </button>
          <button class="btn btn-xs btn-outline-light" onclick="window.aimChat.sendSurveyFilePacket('fbk')" title="Send Civil 3D .FBK File">
            📤 .FBK
          </button>
        </div>

        <!-- Direct 2-Person Chat Log -->
        <div class="aim-msg-log" id="aim-message-log">
          ${this.getConversationHTML(buddy)}
        </div>

        <!-- AIM Formatting Toolbar (Compact) -->
        <div class="aim-format-toolbar compact">
          <button class="fmt-btn ${this.isBold ? 'active' : ''}" onclick="window.aimChat.toggleFormat('bold')" title="Bold"><b>B</b></button>
          <button class="fmt-btn ${this.isItalic ? 'active' : ''}" onclick="window.aimChat.toggleFormat('italic')" title="Italic"><i>I</i></button>
          <button class="fmt-btn ${this.isUnderline ? 'active' : ''}" onclick="window.aimChat.toggleFormat('underline')" title="Underline"><u>U</u></button>
          <select class="fmt-select" onchange="window.aimChat.setFontColor(this.value)" title="Text Color">
            <option value="#000000">Black</option>
            <option value="#0000ff">Blue</option>
            <option value="#ff0000">Red</option>
            <option value="#008000">Green</option>
          </select>
          <button class="fmt-btn" onclick="window.aimChat.insertEmoticon(':-)')">😊</button>
          <button class="fmt-btn" onclick="window.aimChat.insertEmoticon(':-P')">😜</button>
          <button class="fmt-btn" onclick="window.aimChat.insertEmoticon('B-)')">😎</button>
        </div>

        <!-- Input Box & Send Bar -->
        <div class="aim-input-box">
          <textarea id="aim-text-input" placeholder="Direct IM to ${partnerShort}... (Enter to send)" onkeydown="if(event.key==='Enter' && !event.shiftKey){ event.preventDefault(); window.aimChat.handleSend(); }"></textarea>
          <div class="aim-send-row">
            <span class="aim-tip">🔒 Direct 2-Person Link</span>
            <button class="aim-send-btn" onclick="window.aimChat.handleSend()">Send</button>
          </div>
        </div>
      </div>
    `;

    this.scrollToBottom();
  }

  handleSend() {
    const input = document.getElementById('aim-text-input');
    if (!input) return;
    const val = input.value.trim();
    if (val) {
      this.sendMessage(val);
      input.value = "";
    }
  }

  toggleFormat(type) {
    if (type === 'bold') this.isBold = !this.isBold;
    if (type === 'italic') this.isItalic = !this.isItalic;
    if (type === 'underline') this.isUnderline = !this.isUnderline;
    this.renderAim();
  }

  setFontColor(color) {
    this.textColor = color;
  }

  insertEmoticon(emo) {
    const input = document.getElementById('aim-text-input');
    if (input) {
      input.value += " " + emo + " ";
      input.focus();
    }
  }

  promptSendPoint() {
    const id = prompt("Enter Survey Point ID to send to partner (e.g. 10):", "10");
    if (id) {
      this.sendPointToChat(Number(id));
    }
  }

  promptRequestLinework() {
    const feat = prompt("Enter Civil 3D linework to request (e.g. Lot 14 Boundary):", "Lot 14 Property Boundary");
    if (feat) {
      this.sendMessage(`📏 Requesting Civil 3D linework overlay for: ${feat}. Please send DXF/FBK export.`);
    }
  }

  renderConversation() {
    const buddy = this._getResolvedActiveBuddy();
    const log = document.getElementById('aim-message-log');
    if (log && buddy) {
      log.innerHTML = this.getConversationHTML(buddy);
      this.scrollToBottom();
    }
  }

  // Kept for backward compatibility
  renderBuddyList() {}

  scrollToBottom() {
    const log = document.getElementById('aim-message-log');
    if (log) {
      log.scrollTop = log.scrollHeight;
    }
  }
}

window.AimChat = AimChat;
window.aimChat = new AimChat();

// --- js/app.js ---
// Main Application Controller, Topcon/Sokkia Equipment Profiles & Device Viewport Switcher
class SurveyApp {
  constructor() {
    this.currentTab = 'aim'; // 'aim', 'fieldbook', 'jobs', 'cad', 'points'
    this.deviceMode = 'phone'; // 'phone', 'tablet', 'cad-station'
    this.sunlightMode = false;
    this.equipmentProfile = {
      brandPreset: 'topcon', // 'topcon', 'sokkia', 'mixed'
      tablet: 'Topcon FC-6000',
      software: 'MAGNET Field v8.2',
      gps: 'Topcon HiPer VR',
      totalStation: 'Sokkia iX-1200',
      sensorMode: 'GNSS_RTK', // 'GNSS_RTK' or 'ROBOTIC_TS'
      network: 'TopNET Live VRS',
      cadOffice: 'Autodesk Civil 3D 2026',
      rodHeight: 6.562,
      prismConstMm: -30
    };
  }

  init() {
    this.loadEquipmentProfile();

    // 1. Initialize Points Manager
    window.pointManager.init(window.SAMPLE_DATA.points);
    window.pointManager.setEquipmentProfile(this.equipmentProfile);

    // 2. Initialize Survey Linework Engine
    window.cadEngine = new window.CadEngine('cad-canvas');
    window.cadEngine.init(window.SAMPLE_DATA.linework);

    // 3. Initialize Jobs & Checklist Manager
    window.jobManager.init(window.SAMPLE_DATA.jobs);
    this.syncActiveJobHeader();

    // 4. Initialize Digital Field Book & Monument Notes
    window.fieldBook.init(window.SAMPLE_DATA.fieldNotes);

    // 5. Initialize AOL Instant Messenger Chat
    window.aimChat.init(window.SAMPLE_DATA.aim);

    // 6. Setup Point Manager UI listener
    window.pointManager.subscribe(() => {
      this.renderPointsTable();
      if (window.cadEngine) window.cadEngine.render();
    });

    this.renderPointsTable();
    this.bindGlobalEvents();
    this.applyEquipmentProfileUI();
    this.updateClock();
    setInterval(() => this.updateClock(), 1000);

    // Start Topcon / Sokkia GNSS & Robotic TS HUD live readout
    this.startGnssHudTick();

    // Switch to initial tab: Live AIM Chat linking Civil 3D Office & Field Crew
    this.switchTab('aim');
  }

  loadEquipmentProfile() {
    const saved = localStorage.getItem('survey_equipment_profile');
    if (saved) {
      try {
        this.equipmentProfile = { ...this.equipmentProfile, ...JSON.parse(saved) };
      } catch (e) {}
    }
  }

  saveEquipmentProfile() {
    localStorage.setItem('survey_equipment_profile', JSON.stringify(this.equipmentProfile));
  }

  applyEquipmentProfileUI() {
    const p = this.equipmentProfile;
    const wrapper = document.getElementById('device-wrapper');
    if (wrapper) {
      wrapper.classList.remove('brand-topcon', 'brand-sokkia');
      const isSokkiaTablet = /sokkia|shc/i.test(p.tablet);
      wrapper.classList.add(isSokkiaTablet ? 'brand-sokkia' : 'brand-topcon');
    }

    const hudModel = document.getElementById('hud-model');
    const hudDevice = document.getElementById('hud-device');
    const hudSw = document.getElementById('hud-sw');
    const hudNetwork = document.getElementById('hud-network');
    const hudLink = document.getElementById('hud-link');
    const brandTopcon = document.getElementById('hud-brand-topcon');
    const brandSokkia = document.getElementById('hud-brand-sokkia');

    if (hudModel) {
      hudModel.textContent = p.sensorMode === 'ROBOTIC_TS'
        ? `${p.totalStation} (${p.prismConstMm}mm)`
        : `${p.gps} / ${p.totalStation.split(' ')[1] || 'TS'}`;
    }
    if (hudDevice) hudDevice.textContent = p.tablet;
    if (hudSw) hudSw.textContent = p.software;
    if (hudNetwork) {
      hudNetwork.textContent = p.sensorMode === 'ROBOTIC_TS' ? 'Robotic Prism Lock' : p.network;
    }
    if (hudLink) {
      hudLink.textContent = p.sensorMode === 'ROBOTIC_TS' ? 'LongLink Radio ✔' : 'LongLink BT ✔';
    }
    if (brandTopcon && brandSokkia) {
      const topconPrimary = !/sokkia|shc/i.test(p.tablet);
      brandTopcon.style.order = topconPrimary ? '1' : '2';
      brandSokkia.style.order = topconPrimary ? '2' : '1';
      brandTopcon.style.opacity = /topcon|fc-/i.test(p.tablet + ' ' + p.gps + ' ' + p.totalStation) ? '1' : '0.45';
      brandSokkia.style.opacity = /sokkia|shc|grx|gcx|ix/i.test(p.tablet + ' ' + p.gps + ' ' + p.totalStation) ? '1' : '0.45';
    }

    if (window.pointManager) {
      window.pointManager.setEquipmentProfile(p);
    }
  }

  syncActiveJobHeader() {
    const job = window.jobManager ? window.jobManager.getCurrentJob() : null;
    if (!job) return;
    const titleEl = document.getElementById('app-bar-job-name');
    const subEl = document.getElementById('app-bar-job-sub');
    if (titleEl) titleEl.textContent = `#${job.number} ${job.name.split(' - ')[0]}`;
    if (subEl) subEl.textContent = `${job.location} • ${this.equipmentProfile.software}`;
  }

  switchTab(tabName) {
    const resolvedTab = (tabName === 'aim' || tabName === 'cad') ? 'cad' : tabName;
    this.currentTab = resolvedTab;

    document.querySelectorAll('.android-nav-item').forEach(item => {
      const itemTab = item.dataset.tab;
      const isActive = itemTab === resolvedTab || (resolvedTab === 'cad' && (itemTab === 'cad' || itemTab === 'aim'));
      item.classList.toggle('active', isActive);
    });

    document.querySelectorAll('.app-view').forEach(view => {
      view.classList.toggle('active', view.id === `view-${resolvedTab}`);
    });

    if (resolvedTab === 'cad') {
      if (window.cadEngine) {
        setTimeout(() => {
          window.cadEngine.resizeCanvas();
          window.cadEngine.render();
        }, 50);
      }
      if (window.aimChat) {
        window.aimChat.renderAim();
      }
    } else if (resolvedTab === 'jobs' && window.jobManager) {
      window.jobManager.render();
    } else if (resolvedTab === 'fieldbook' && window.fieldBook) {
      window.fieldBook.renderFieldBook();
    } else if (resolvedTab === 'points') {
      this.renderPointsTable();
    }
  }

  switchPlatformEntity(platform) {
    this.platformEntity = platform; // 'android', 'iphone', 'desktop'

    document.querySelectorAll('.platform-entity-tab').forEach(tab => {
      tab.classList.toggle('active', tab.id === `tab-ent-${platform}`);
    });

    const frame = document.getElementById('device-wrapper');
    if (!frame) return;

    frame.classList.remove('mode-phone', 'mode-iphone', 'mode-tablet', 'mode-cad-station', 'mode-desktop-app');

    // Remove any existing dynamic island before re-adding
    const existingIsland = frame.querySelector('.iphone-dynamic-island');
    if (existingIsland) existingIsland.remove();

    if (platform === 'iphone') {
      frame.classList.add('mode-iphone');
      const island = document.createElement('div');
      island.className = 'iphone-dynamic-island';
      island.onclick = () => window.app.openEquipmentModal();
      island.title = 'Dynamic Island: Tap to configure GNSS & Total Station';
      island.innerHTML = `
        <div class="island-sensor-dot"></div>
        <div class="island-rtk-indicator">
          <div class="island-pulse-dot"></div>
          <span>RTK FIXED</span>
        </div>
      `;
      frame.insertBefore(island, frame.firstChild);

      if (window.aimChat && window.aimChat.currentUser.role !== 'field') {
        window.aimChat.switchUserRole('field');
      }
    } else if (platform === 'android') {
      frame.classList.add('mode-phone');
      if (window.aimChat && window.aimChat.currentUser.role !== 'field') {
        window.aimChat.switchUserRole('field');
      }
    } else if (platform === 'desktop') {
      frame.classList.add('mode-desktop-app');
      if (window.aimChat && window.aimChat.currentUser.role !== 'cad') {
        window.aimChat.switchUserRole('cad');
      }
    }

    if (window.cadEngine) {
      setTimeout(() => {
        window.cadEngine.resizeCanvas();
        window.cadEngine.render();
      }, 100);
    }
    if (window.aimChat) {
      window.aimChat.renderAim();
    }
  }

  setDeviceMode(mode) {
    if (mode === 'iphone') return this.switchPlatformEntity('iphone');
    if (mode === 'phone') return this.switchPlatformEntity('android');
    if (mode === 'cad-station') return this.switchPlatformEntity('desktop');

    this.deviceMode = mode;
    const frame = document.getElementById('device-wrapper');
    if (!frame) return;

    frame.classList.remove('mode-phone', 'mode-iphone', 'mode-tablet', 'mode-cad-station', 'mode-desktop-app');
    frame.classList.add(`mode-${mode}`);

    document.querySelectorAll('.mode-toggle-btn').forEach(btn => {
      btn.classList.toggle('active', btn.dataset.mode === mode);
    });

    if (window.cadEngine) {
      setTimeout(() => {
        window.cadEngine.resizeCanvas();
        window.cadEngine.render();
      }, 100);
    }
    if (window.aimChat) {
      window.aimChat.renderAim();
    }
  }

  toggleSunlightMode() {
    this.sunlightMode = !this.sunlightMode;
    document.body.classList.toggle('sunlight-mode', this.sunlightMode);
    const btn = document.getElementById('btn-sunlight-toggle');
    if (btn) {
      btn.classList.toggle('active', this.sunlightMode);
      btn.innerHTML = this.sunlightMode ? '☀️ Sunlight: ON' : '🕶️ Sunlight';
    }
    if (window.soundFX) window.soundFX.playShotBeep();
  }

  bindGlobalEvents() {
    const dxfInput = document.getElementById('file-dxf-import');
    if (dxfInput) dxfInput.addEventListener('change', e => this.handleDxfFileSelect(e));

    const csvInput = document.getElementById('file-csv-import');
    if (csvInput) csvInput.addEventListener('change', e => this.handleCsvFileSelect(e));

    const rw5Input = document.getElementById('file-rw5-import');
    if (rw5Input) rw5Input.addEventListener('change', e => this.handleRw5FileSelect(e));

    const fbkInput = document.getElementById('file-fbk-import');
    if (fbkInput) fbkInput.addEventListener('change', e => this.handleFbkFileSelect(e));
  }

  showToast(message, durationMs = 3400) {
    const container = document.getElementById('toast-container');
    if (!container) return;
    const toast = document.createElement('div');
    toast.className = 'app-toast';
    toast.textContent = message;
    container.appendChild(toast);
    setTimeout(() => {
      toast.classList.add('fade-out');
      setTimeout(() => toast.remove(), 250);
    }, durationMs);
  }

  runMagnetAutoLines() {
    if (!window.cadEngine) return;
    const count = window.cadEngine.buildLineworkFromCurrentPoints();
    this.showToast(`MAGNET Field codes parsed → ${count} Civil 3D linework figures built!`);
  }

  handleDxfFileSelect(e) {
    const file = e.target.files[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = (event) => {
      const parsed = window.dxfManager.parseDxf(event.target.result);
      if (parsed.points.length > 0 || parsed.linework.length > 0) {
        parsed.points.forEach(p => window.pointManager.addPoint(p));
        parsed.linework.forEach(l => window.cadEngine.linework.push(l));

        window.cadEngine.save();
        window.cadEngine.fitExtents();
        window.cadEngine.render();
        this.renderPointsTable();

        const msg = `Imported Civil 3D DXF (${file.name}): ${parsed.linework.length} linework entities, ${parsed.points.length} points.`;
        this.showToast(msg);
        if (window.aimChat) window.aimChat.postSystemUpdate(`📥 ${msg}`);
        if (window.soundFX) window.soundFX.playShotBeep();
      } else {
        this.showToast("Could not detect 2D line or point entities in DXF file.");
      }
    };
    reader.readAsText(file);
    e.target.value = "";
  }

  handleCsvFileSelect(e) {
    const file = e.target.files[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = (event) => {
      const parsed = window.dxfManager.parseCsv(event.target.result);
      if (parsed.length > 0) {
        parsed.forEach(p => window.pointManager.addPoint(p));
        this.renderPointsTable();
        if (window.cadEngine) {
          window.cadEngine.fitExtents();
          window.cadEngine.render();
        }
        const msg = `Imported ${parsed.length} PNEZD points from ${file.name}.`;
        this.showToast(msg);
        if (window.aimChat) window.aimChat.postSystemUpdate(`📥 ${msg}`);
        if (window.soundFX) window.soundFX.playShotBeep();
      } else {
        this.showToast("No valid coordinate rows found. Ensure P,N,E,Z,D format.");
      }
    };
    reader.readAsText(file);
    e.target.value = "";
  }

  handleRw5FileSelect(e) {
    const file = e.target.files[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = (event) => {
      const parsed = window.dxfManager.parseMagnetRaw(event.target.result);
      if (parsed.points.length > 0) {
        parsed.points.forEach(p => window.pointManager.addPoint(p));
        const linesBuilt = window.cadEngine ? window.cadEngine.buildLineworkFromCurrentPoints() : 0;
        this.renderPointsTable();
        if (window.cadEngine) {
          window.cadEngine.fitExtents();
          window.cadEngine.render();
        }
        const msg = `Imported MAGNET Field ${file.name}: ${parsed.points.length} shots (${linesBuilt} Civil 3D figures updated).`;
        this.showToast(msg);
        if (window.aimChat) window.aimChat.postSystemUpdate(`📥 ${msg}`);
        if (window.soundFX) window.soundFX.playShotBeep();
      } else {
        this.showToast("No valid KP/SP/GPS records found in .RW5/.RAW file.");
      }
    };
    reader.readAsText(file);
    e.target.value = "";
  }

  handleFbkFileSelect(e) {
    const file = e.target.files[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = (event) => {
      const parsed = window.dxfManager.parseCivil3dFbk(event.target.result);
      if (parsed.points.length > 0 || parsed.linework.length > 0) {
        parsed.points.forEach(p => window.pointManager.addPoint(p));
        parsed.linework.forEach(l => window.cadEngine.linework.push(l));
        window.cadEngine.save();
        this.renderPointsTable();
        if (window.cadEngine) {
          window.cadEngine.fitExtents();
          window.cadEngine.render();
        }
        const msg = `Imported Civil 3D .FBK (${file.name}): ${parsed.points.length} pts, ${parsed.linework.length} figures.`;
        this.showToast(msg);
        if (window.aimChat) window.aimChat.postSystemUpdate(`📥 ${msg}`);
        if (window.soundFX) window.soundFX.playShotBeep();
      } else {
        this.showToast("No valid CR NEZ / NEZ / BEG records found in .FBK file.");
      }
    };
    reader.readAsText(file);
    e.target.value = "";
  }

  renderPointsTable() {
    const tbody = document.getElementById('points-table-body');
    const countEl = document.getElementById('points-count-badge');
    if (!tbody || !window.pointManager) return;

    const points = window.pointManager.getAll();
    if (countEl) countEl.textContent = `${points.length} Shots`;

    const filterVal = (document.getElementById('points-search-input')?.value || "").toLowerCase();

    const filtered = points.filter(p =>
      String(p.id).includes(filterVal) ||
      (p.code || "").toLowerCase().includes(filterVal) ||
      (p.desc || "").toLowerCase().includes(filterVal)
    );

    tbody.innerHTML = filtered.map(p => `
      <tr class="point-row">
        <td><b>#${p.id}</b></td>
        <td><span class="badge ${p.type || 'TOPO'}">${p.code}</span></td>
        <td class="font-mono">${p.northing.toFixed(3)}</td>
        <td class="font-mono">${p.easting.toFixed(3)}</td>
        <td class="font-mono font-bold">${p.elevation.toFixed(3)}'</td>
        <td class="text-sm text-muted">${p.desc || '-'}</td>
        <td class="text-sm">${(p.hr || 5.0).toFixed(2)}'</td>
        <td>
          <button class="btn btn-xs btn-outline-info" onclick="window.cadEngine.zoomToPoint(${p.id}); window.app.switchTab('cad');" title="Zoom on Canvas">🔍</button>
          <button class="btn btn-xs btn-outline-primary" onclick="window.aimChat.sendPointToChat(${p.id}); window.app.switchTab('aim');" title="Send to AIM">💬</button>
          <button class="btn btn-xs btn-outline-danger" onclick="window.app.deletePoint(${p.id})" title="Delete Point">🗑️</button>
        </td>
      </tr>
    `).join('');
  }

  deletePoint(id) {
    if (confirm(`Delete survey point #${id}?`)) {
      window.pointManager.deletePoint(id);
    }
  }

  promptTakeRtkShot() {
    const rtk = window.pointManager ? window.pointManager.rtkStatus : { curN: 10245.8, curE: 10185.35, curZ: 688.15 };
    this.openQuickShotModal(rtk.curN, rtk.curE, rtk.curZ, 'rtk');
  }

  // Sleek Touch-Friendly MAGNET Field Code & Quick Shot Modal
  openQuickShotModal(northing, easting, elevation, source = 'rtk') {
    const root = document.getElementById('modal-root');
    if (!root) return;

    const p = this.equipmentProfile;
    const defaultRod = p.sensorMode === 'ROBOTIC_TS' ? 5.000 : p.rodHeight;
    const quickCodes = [
      'IP FND', 'IP SET', 'CP', 'BM',
      'CL1 B', 'CL1', 'CL1 E',
      'EP1 B', 'EP1', 'EP1 E',
      'BLDG1 B', 'BLDG1', 'BLDG1 E', 'FFE',
      'WM', 'WV', 'FH', 'MH SAN', 'CB STM',
      'FENCE B', 'FENCE E', 'TREE'
    ];

    root.innerHTML = `
      <div class="modal-overlay" onclick="if(event.target===this) window.app.closeModal()">
        <div class="survey-modal-card">
          <div class="survey-modal-header">
            <div>
              <h3>🎯 ${source === 'canvas' ? 'Store Canvas Point' : 'Store MAGNET Field Shot'}</h3>
              <span class="text-xs text-muted">${p.tablet} • ${p.software} • ${p.sensorMode === 'ROBOTIC_TS' ? p.totalStation : p.gps}</span>
            </div>
            <button class="btn-close" onclick="window.app.closeModal()">×</button>
          </div>

          <div class="shot-coords-banner">
            <span>N: <b>${Number(northing).toFixed(3)}</b></span>
            <span>E: <b>${Number(easting).toFixed(3)}</b></span>
            <span>Z: <b>${Number(elevation).toFixed(3)}'</b></span>
          </div>

          <div class="shot-quick-codes">
            <label class="modal-label">MAGNET Field Quick Codes (Tap to fill):</label>
            <div class="quick-code-grid">
              ${quickCodes.map(c => `
                <button type="button" class="quick-code-chip" onclick="document.getElementById('qs-code').value='${c}'; document.querySelectorAll('.quick-code-chip').forEach(b=>b.classList.remove('active')); this.classList.add('active');">${c}</button>
              `).join('')}
            </div>
          </div>

          <div class="modal-form-grid">
            <div>
              <label class="modal-label">Feature Code</label>
              <input type="text" id="qs-code" class="modal-input" value="TOPO" placeholder="e.g. EP1 B, IP FND, MH SAN">
            </div>
            <div>
              <label class="modal-label">Rod / Prism Height (ft)</label>
              <input type="number" step="0.001" id="qs-rod" class="modal-input" value="${Number(defaultRod).toFixed(3)}">
            </div>
          </div>

          <div style="margin-top:8px;">
            <label class="modal-label">Civil 3D Raw Description / Notes</label>
            <input type="text" id="qs-desc" class="modal-input" value="${source === 'canvas' ? 'Canvas Digitized Point' : (p.sensorMode === 'ROBOTIC_TS' ? 'Sokkia/Topcon Robotic Prism Shot' : 'Topcon/Sokkia RTK Fixed Shot')}">
          </div>

          <label class="modal-checkbox-row">
            <input type="checkbox" id="qs-send-aim" checked>
            <span>Also send point badge to Civil 3D Office in AIM Chat</span>
          </label>

          <div class="survey-modal-footer">
            <button class="btn btn-sm btn-secondary" onclick="window.app.closeModal()">Cancel</button>
            <button class="btn btn-sm btn-success" onclick="window.app.submitQuickShot(${Number(northing)}, ${Number(easting)}, ${Number(elevation)}, '${source}')">
              ✅ Store Shot
            </button>
          </div>
        </div>
      </div>
    `;
  }

  submitQuickShot(northing, easting, elevation, source) {
    const code = (document.getElementById('qs-code')?.value || 'TOPO').trim().toUpperCase();
    const rod = parseFloat(document.getElementById('qs-rod')?.value) || this.equipmentProfile.rodHeight;
    const desc = (document.getElementById('qs-desc')?.value || '').trim();
    const sendAim = !!document.getElementById('qs-send-aim')?.checked;

    const pt = source === 'canvas'
      ? window.pointManager.addPoint({ northing, easting, elevation, code, desc, hr: rod })
      : window.pointManager.takeRtkShot(code, desc, rod);

    this.closeModal();
    this.renderPointsTable();
    if (window.cadEngine) window.cadEngine.render();

    if (sendAim && window.aimChat) {
      window.aimChat.sendPointToChat(pt.id);
    }
    this.showToast(`Stored PT #${pt.id} [${pt.code}] @ N:${pt.northing.toFixed(2)} E:${pt.easting.toFixed(2)}`);
  }

  // Modal for Coworkers to Download Android, iPhone, and PC Packages
  openDownloadModal() {
    const root = document.getElementById('modal-root');
    if (!root) return;

    root.innerHTML = `
      <div class="modal-overlay" onclick="if(event.target===this) window.app.closeModal()">
        <div class="survey-modal-card" style="max-width: 580px;">
          <div class="survey-modal-header">
            <div style="display: flex; align-items: center; gap: 10px;">
              <img src="data:image/png;base64," alt="Logo" class="modal-brand-logo" style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover; border: 1.5px solid var(--accent-primary); box-shadow: 0 0 8px rgba(56,189,248,0.3);">
              <div>
                <h3>📥 Download Testing Packages for Coworkers</h3>
                <span class="text-xs text-muted">Standalone offline test packages for Android, iPhone, and Computer Program</span>
              </div>
            </div>
            <button class="btn-close" onclick="window.app.closeModal()">×</button>
          </div>

          <div class="download-package-list" style="display: flex; flex-direction: column; gap: 12px; margin-top: 10px;">
            <!-- 1. Android App Package -->
            <div class="download-card" style="background: rgba(30, 41, 59, 0.7); border: 1px solid #334155; border-radius: 8px; padding: 12px; display: flex; align-items: center; justify-content: space-between;">
              <div style="padding-right: 12px;">
                <div style="display: flex; align-items: center; gap: 6px;">
                  <span style="font-size: 18px;">🤖</span>
                  <b style="color: #22c55e;">GeoSurvey Android App Package</b>
                  <span class="badge" style="background: rgba(34, 197, 94, 0.2); color: #22c55e; font-size: 10px;">1.2 MB .ZIP</span>
                </div>
                <div class="text-xs text-muted" style="margin-top: 4px;">
                  For Android phones &amp; Topcon/Sokkia FC-6000 field tablets. Includes local launchers &amp; PWA install guide.
                </div>
              </div>
              <a href="downloads/GeoSurvey-Android-App.zip" download="GeoSurvey-Android-App.zip" class="btn btn-sm btn-success" style="font-weight: 700; white-space: nowrap;">
                ⬇️ Download ZIP
              </a>
            </div>

            <!-- 2. iPhone App Package -->
            <div class="download-card" style="background: rgba(30, 41, 59, 0.7); border: 1px solid #334155; border-radius: 8px; padding: 12px; display: flex; align-items: center; justify-content: space-between;">
              <div style="padding-right: 12px;">
                <div style="display: flex; align-items: center; gap: 6px;">
                  <span style="font-size: 18px;">🍎</span>
                  <b style="color: #38bdf8;">GeoSurvey iPhone / iOS Package</b>
                  <span class="badge" style="background: rgba(56, 189, 248, 0.2); color: #38bdf8; font-size: 10px;">1.2 MB .ZIP</span>
                </div>
                <div class="text-xs text-muted" style="margin-top: 4px;">
                  For Apple iPhone 16/15 Pro (iOS 15+). Includes Dynamic Island, Cupertino tabs &amp; iOS home screen install guide.
                </div>
              </div>
              <a href="downloads/GeoSurvey-iPhone-App.zip" download="GeoSurvey-iPhone-App.zip" class="btn btn-sm btn-primary" style="font-weight: 700; white-space: nowrap;">
                ⬇️ Download ZIP
              </a>
            </div>

            <!-- 3. Computer Program Package -->
            <div class="download-card" style="background: rgba(30, 41, 59, 0.7); border: 1px solid #334155; border-radius: 8px; padding: 12px; display: flex; align-items: center; justify-content: space-between;">
              <div style="padding-right: 12px;">
                <div style="display: flex; align-items: center; gap: 6px;">
                  <span style="font-size: 18px;">🖥️</span>
                  <b style="color: #f59e0b;">Civil 3D Workstation Computer Program</b>
                  <span class="badge" style="background: rgba(245, 158, 11, 0.2); color: #f59e0b; font-size: 10px;">1.2 MB .ZIP</span>
                </div>
                <div class="text-xs text-muted" style="margin-top: 4px;">
                  For Windows &amp; Mac CAD drafters. Includes 1-click desktop batch launcher (.bat / .sh) &amp; Civil 3D testing samples.
                </div>
              </div>
              <a href="downloads/GeoSurvey-Computer-Program.zip" download="GeoSurvey-Computer-Program.zip" class="btn btn-sm btn-warning" style="font-weight: 700; white-space: nowrap; color: #0b0f19;">
                ⬇️ Download ZIP
              </a>
            </div>
          </div>

          <div style="margin-top: 14px; text-align: right;">
            <button class="btn btn-xs btn-outline-light" onclick="window.app.closeModal()">Close</button>
          </div>
        </div>
      </div>
    `;
  }

  // Topcon / Sokkia / MAGNET Field / Civil 3D Kit Config Modal
  openEquipmentModal() {
    const root = document.getElementById('modal-root');
    if (!root) return;
    const p = this.equipmentProfile;

    root.innerHTML = `
      <div class="modal-overlay" onclick="if(event.target===this) window.app.closeModal()">
        <div class="survey-modal-card">
          <div class="survey-modal-header">
            <div style="display: flex; align-items: center; gap: 10px;">
              <img src="data:image/png;base64," alt="Logo" class="modal-brand-logo" style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover; border: 1.5px solid var(--accent-primary); box-shadow: 0 0 8px rgba(56,189,248,0.3);">
              <div>
                <h3>⚙️ Topcon / Sokkia & Civil 3D Kit</h3>
                <span class="text-xs text-muted">Configure your field tablet, GNSS receiver, robotic total station & Civil 3D target</span>
              </div>
            </div>
            <button class="btn-close" onclick="window.app.closeModal()">×</button>
          </div>

          <div class="preset-btn-row">
            <button type="button" class="btn btn-xs btn-outline-warning" onclick="window.app.applyPresetInModal('topcon')">🟡 Topcon Full Kit (FC-6000 + HiPer VR)</button>
            <button type="button" class="btn btn-xs btn-outline-primary" onclick="window.app.applyPresetInModal('sokkia')">🔵 Sokkia Full Kit (SHC6000 + GRX3 + iX-1200)</button>
            <button type="button" class="btn btn-xs btn-outline-light" onclick="window.app.applyPresetInModal('mixed')">⚡ Mixed Topcon / Sokkia</button>
          </div>

          <div class="modal-form-grid">
            <div>
              <label class="modal-label">Rugged Field Tablet</label>
              <select id="eq-tablet" class="modal-input">
                <option ${p.tablet === 'Topcon FC-6000' ? 'selected' : ''}>Topcon FC-6000</option>
                <option ${p.tablet === 'Topcon FC-6400' ? 'selected' : ''}>Topcon FC-6400</option>
                <option ${p.tablet === 'Sokkia SHC6000' ? 'selected' : ''}>Sokkia SHC6000</option>
                <option ${p.tablet === 'Sokkia SHC6400' ? 'selected' : ''}>Sokkia SHC6400</option>
              </select>
            </div>
            <div>
              <label class="modal-label">Field Software</label>
              <select id="eq-software" class="modal-input">
                <option ${p.software === 'MAGNET Field v8.2' ? 'selected' : ''}>MAGNET Field v8.2</option>
                <option ${p.software === 'MAGNET Field v8.0' ? 'selected' : ''}>MAGNET Field v8.0</option>
                <option ${p.software === 'MAGNET Field v7.5' ? 'selected' : ''}>MAGNET Field v7.5</option>
              </select>
            </div>
            <div>
              <label class="modal-label">GPS / GNSS Receiver</label>
              <select id="eq-gps" class="modal-input">
                <option ${p.gps === 'Topcon HiPer VR' ? 'selected' : ''}>Topcon HiPer VR</option>
                <option ${p.gps === 'Topcon HiPer HR' ? 'selected' : ''}>Topcon HiPer HR</option>
                <option ${p.gps === 'Sokkia GRX3' ? 'selected' : ''}>Sokkia GRX3</option>
                <option ${p.gps === 'Sokkia GCX3' ? 'selected' : ''}>Sokkia GCX3</option>
              </select>
            </div>
            <div>
              <label class="modal-label">Robotic Total Station</label>
              <select id="eq-ts" class="modal-input">
                <option ${p.totalStation === 'Sokkia iX-1200' ? 'selected' : ''}>Sokkia iX-1200</option>
                <option ${p.totalStation === 'Topcon GT-1200' ? 'selected' : ''}>Topcon GT-1200</option>
                <option ${p.totalStation === 'Sokkia iX-1000' ? 'selected' : ''}>Sokkia iX-1000</option>
                <option ${p.totalStation === 'Topcon GT-600' ? 'selected' : ''}>Topcon GT-600</option>
              </select>
            </div>
            <div>
              <label class="modal-label">Active Field Sensor Mode</label>
              <select id="eq-mode" class="modal-input">
                <option value="GNSS_RTK" ${p.sensorMode === 'GNSS_RTK' ? 'selected' : ''}>🛰️ GNSS RTK Rover (VRS / Base)</option>
                <option value="ROBOTIC_TS" ${p.sensorMode === 'ROBOTIC_TS' ? 'selected' : ''}>🔭 Robotic Total Station (Prism)</option>
              </select>
            </div>
            <div>
              <label class="modal-label">RTK Correction Network</label>
              <select id="eq-network" class="modal-input">
                <option ${p.network === 'TopNET Live VRS' ? 'selected' : ''}>TopNET Live VRS</option>
                <option ${p.network === 'TxDOT VRS NTRIP' ? 'selected' : ''}>TxDOT VRS NTRIP</option>
                <option ${p.network === 'Base/Rover UHF 450MHz' ? 'selected' : ''}>Base/Rover UHF 450MHz</option>
                <option ${p.network === 'LongLink BT 915MHz' ? 'selected' : ''}>LongLink BT 915MHz</option>
              </select>
            </div>
            <div>
              <label class="modal-label">Default Rod Height (ft)</label>
              <input type="number" step="0.001" id="eq-rod" class="modal-input" value="${Number(p.rodHeight).toFixed(3)}">
            </div>
            <div>
              <label class="modal-label">Office CAD Platform</label>
              <select id="eq-cad" class="modal-input">
                <option ${p.cadOffice === 'Autodesk Civil 3D 2026' ? 'selected' : ''}>Autodesk Civil 3D 2026</option>
                <option ${p.cadOffice === 'Autodesk Civil 3D 2025' ? 'selected' : ''}>Autodesk Civil 3D 2025</option>
                <option ${p.cadOffice === 'Autodesk Civil 3D 2024' ? 'selected' : ''}>Autodesk Civil 3D 2024</option>
              </select>
            </div>
          </div>

          <div class="survey-modal-footer">
            <button class="btn btn-sm btn-secondary" onclick="window.app.closeModal()">Cancel</button>
            <button class="btn btn-sm btn-primary" onclick="window.app.saveEquipmentFromModal()">💾 Apply Hardware Profile</button>
          </div>
        </div>
      </div>
    `;
  }

  applyPresetInModal(preset) {
    const tablet = document.getElementById('eq-tablet');
    const gps = document.getElementById('eq-gps');
    const ts = document.getElementById('eq-ts');
    const net = document.getElementById('eq-network');
    if (!tablet || !gps || !ts) return;

    if (preset === 'topcon') {
      tablet.value = 'Topcon FC-6000';
      gps.value = 'Topcon HiPer VR';
      ts.value = 'Topcon GT-1200';
      if (net) net.value = 'TopNET Live VRS';
    } else if (preset === 'sokkia') {
      tablet.value = 'Sokkia SHC6000';
      gps.value = 'Sokkia GRX3';
      ts.value = 'Sokkia iX-1200';
      if (net) net.value = 'TopNET Live VRS';
    } else {
      tablet.value = 'Topcon FC-6000';
      gps.value = 'Topcon HiPer VR';
      ts.value = 'Sokkia iX-1200';
    }
  }

  saveEquipmentFromModal() {
    this.equipmentProfile = {
      ...this.equipmentProfile,
      tablet: document.getElementById('eq-tablet')?.value || this.equipmentProfile.tablet,
      software: document.getElementById('eq-software')?.value || this.equipmentProfile.software,
      gps: document.getElementById('eq-gps')?.value || this.equipmentProfile.gps,
      totalStation: document.getElementById('eq-ts')?.value || this.equipmentProfile.totalStation,
      sensorMode: document.getElementById('eq-mode')?.value || 'GNSS_RTK',
      network: document.getElementById('eq-network')?.value || this.equipmentProfile.network,
      rodHeight: parseFloat(document.getElementById('eq-rod')?.value) || 6.562,
      cadOffice: document.getElementById('eq-cad')?.value || 'Autodesk Civil 3D 2026'
    };

    this.saveEquipmentProfile();
    this.applyEquipmentProfileUI();
    this.syncActiveJobHeader();
    if (this.currentTab === 'fieldbook' && window.fieldBook) window.fieldBook.renderFieldBook();
    this.closeModal();
    if (window.soundFX) window.soundFX.playShotBeep();
    this.showToast(`Active kit: ${this.equipmentProfile.tablet} + ${this.equipmentProfile.software}`);
  }

  closeModal() {
    const root = document.getElementById('modal-root');
    if (root) root.innerHTML = '';
  }

  updateClock() {
    const now = new Date();
    const timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    document.querySelectorAll('.android-clock').forEach(el => el.textContent = timeStr);
  }

  // Unified Topcon / Sokkia GNSS & Robotic TS HUD live readout
  startGnssHudTick() {
    const statusEl = document.getElementById('hud-status');
    const pdopEl = document.getElementById('hud-pdop');
    const satsEl = document.getElementById('hud-sats');
    const hrmsEl = document.getElementById('hud-hrms');
    const vrmsEl = document.getElementById('hud-vrms');
    const networkEl = document.getElementById('hud-network');
    const linkEl = document.getElementById('hud-link');
    const statusBadge = document.getElementById('status-gnss-badge');

    const updateHud = () => {
      const rtk = window.pointManager ? window.pointManager.rtkStatus : null;
      const isTS = this.equipmentProfile.sensorMode === 'ROBOTIC_TS';

      const pdop = rtk ? rtk.pdop.toFixed(2) : '1.05';
      const sats = rtk ? rtk.satellites : 24;
      const hrms = rtk ? rtk.hrms.toFixed(3) : '0.011';
      const vrms = rtk ? rtk.vrms.toFixed(3) : '0.019';

      const isFixed = isTS || (Math.random() > 0.05);
      const statusTxt = isTS ? 'PRISM LOCKED' : (isFixed ? 'RTK FIXED' : 'RTK FLOAT');

      if (statusEl) {
        statusEl.textContent = statusTxt;
        statusEl.className = `gnss-value ${isFixed ? 'gnss-fixed' : 'gnss-float'}`;
      }
      if (statusBadge) {
        statusBadge.textContent = `● ${statusTxt} (${hrms}')`;
      }
      if (pdopEl) pdopEl.textContent = isTS ? '0.0"' : pdop;
      if (satsEl) satsEl.textContent = isTS ? 'TS' : String(sats);
      if (hrmsEl) {
        hrmsEl.textContent = `${hrms} ft`;
        hrmsEl.className = `gnss-value ${isFixed ? 'gnss-fixed' : 'gnss-float'}`;
      }
      if (vrmsEl) {
        vrmsEl.textContent = `${vrms} ft`;
        vrmsEl.className = `gnss-value ${isFixed ? 'gnss-fixed' : 'gnss-float'}`;
      }
      if (networkEl) networkEl.style.opacity = (Math.random() > 0.12) ? '1' : '0.68';
      if (linkEl) {
        linkEl.textContent = isTS ? 'LongLink Radio ✔' : (isFixed ? 'LongLink BT ✔' : 'LongLink BT…');
      }
    };

    updateHud();
    setInterval(updateHud, 2500);
  }
}

window.app = new SurveyApp();


</script>
  
  
  
  
  
  
  
  

  <script>
    window.addEventListener('DOMContentLoaded', () => {
      window.app.deviceMode = 'cad-station';
      window.app.init();
      // CAD Station identity defaults to Dave (Senior Civil 3D Drafter)
      if (window.aimChat) {
        window.aimChat.switchUserRole('cad');
      }
    });
  </script>
</body>
</html>
